n=3D"w" value=3D"function createRateLimiter(maxRequests, windowMs) {
  const requests =3D [];
  return function(fn) {
    const now =3D Date.now();
    // Remove requests outside the window
    while (requests.length &amp;&amp; requests[0] &lt; now - windowMs) {
      requests.shift();
    }
    if (requests.length &gt;=3D maxRequests) {
      return Promise.reject(new Error('Rate limit exceeded'));
    }
    requests.push(now);
    return fn();
  };
}" tabindex=3D"0" role=3D"button">
