  let page =3D 1;
  let hasMore =3D true;
  while (hasMore) {
    const data =3D await fetch(`${baseUrl}?page=3D${page}&amp;limit=3D${pag=
eSize}`)
      .then(r =3D&gt; r.json());
    yield data.items;
    hasMore =3D data.hasNextPage;
    page++;
  }
}

async function loadAll() {
  for await (const items of fetchPages('/api/users')) {
    processItems(items);
  }
