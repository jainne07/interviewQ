n=3D"w" value=3D"async function fetchWithRetry(url, maxRetries =3D 3, delay=
 =3D 1000) {
  for (let attempt =3D 1; attempt &lt;=3D maxRetries; attempt++) {
    try {
      const res =3D await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return await res.json();
    } catch (e) {
      if (attempt =3D=3D=3D maxRetries) throw e;
      await new Promise(r =3D&gt; setTimeout(r, delay * attempt)); // expon=
ential backoff
    }
  }
}" tabindex=3D"0" role=3D"button">
