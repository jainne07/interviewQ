n=3D"w" value=3D"function timeout(ms) {
  return new Promise((_, reject) =3D&gt;
    setTimeout(() =3D&gt; reject(new Error('Timeout')), ms)
  );
}

async function fetchWithTimeout(url, ms) {
  try {
    return await Promise.race([
      fetch(url),
      timeout(ms)
    ]);
  } catch (e) {
    return `Failed: ${e.message}`;
  }
}" tabindex=3D"0" role=3D"button">
