n=3D"w" value=3D"/* Remove default spacing between cells */
table {
  border-collapse: collapse; /* or separate */
  width: 100%;
  font-family: Arial, sans-serif;
}

th, td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid #ddd;
}

th {
  background-color: #4a90d9;
  color: white;
  font-weight: bold;
}

/* Zebra striping */
tbody tr:nth-child(even) {
  background-color: #f5f5f5;
}

/* Hover highlight */
tbody tr:hover {
  background-color: #e8f0fe;
}

/* Caption styling */
caption {
  font-size: 1.2em;
  font-weight: bold;
  margin-bottom: 8px;
  text-align: left;
