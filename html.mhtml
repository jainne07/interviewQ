function animate() {
  r =3D growing ? r + 0.5 : r - 0.5;
  if (r &gt;=3D 35) growing =3D false;
  if (r &lt;=3D 20) growing =3D true;
  circle.setAttribute(&quot;r&quot;, r);
  frame =3D requestAnimationFrame(animate);
}

animate();
