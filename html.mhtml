n=3D"w" value=3D"class UserCard extends HTMLElement {
  // Called when element is added to the DOM
  connectedCallback() {
    const name =3D this.getAttribute(&quot;name&quot;);
    const role =3D this.getAttribute(&quot;role&quot;);

    this.innerHTML =3D `
      &lt;div class=3D&quot;card&quot;&gt;
        &lt;h3&gt;${name}&lt;/h3&gt;
        &lt;p&gt;${role}&lt;/p&gt;
      &lt;/div&gt;
    `;
  }

  // Called when element is removed from the DOM
  disconnectedCallback() {
    console.log(&quot;UserCard removed&quot;);
  }

  // Called when a watched attribute changes
  static get observedAttributes() {
    return [&quot;name&quot;, &quot;role&quot;];
  }

  attributeChangedCallback(name, oldValue, newValue) {
    console.log(`Attribute &quot;${name}&quot; changed from ${oldValue} to =
${newValue}`);
    this.connectedCallback(); // Re-render on attribute change
  }
}

// Register the custom element
