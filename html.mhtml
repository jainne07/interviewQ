            align-items:center;justify-content:center;font-family:sans-seri=
f;&quot;&gt;
  Drop files here
&lt;/div&gt;
&lt;ul id=3D&quot;file-list&quot;&gt;&lt;/ul&gt;

&lt;script&gt;
  const dropzone =3D document.getElementById(&quot;dropzone&quot;);
  const fileList =3D document.getElementById(&quot;file-list&quot;);

  // Prevent default browser behavior (open file in browser)
  [&quot;dragenter&quot;, &quot;dragover&quot;, &quot;dragleave&quot;, &quo=
t;drop&quot;].forEach(event =3D&gt; {
    dropzone.addEventListener(event, (e) =3D&gt; e.preventDefault());
    document.body.addEventListener(event, (e) =3D&gt; e.preventDefault());
  });

  // Visual feedback
  dropzone.addEventListener(&quot;dragover&quot;, () =3D&gt; {
    dropzone.style.borderColor =3D &quot;#4a90d9&quot;;
    dropzone.style.background =3D &quot;#e8f0fe&quot;;
  });

  dropzone.addEventListener(&quot;dragleave&quot;, () =3D&gt; {
    dropzone.style.borderColor =3D &quot;#aaa&quot;;
    dropzone.style.background =3D &quot;&quot;;
  });

  // Handle drop
  dropzone.addEventListener(&quot;drop&quot;, (e) =3D&gt; {
    dropzone.style.borderColor =3D &quot;#aaa&quot;;
    dropzone.style.background =3D &quot;&quot;;

    const files =3D e.dataTransfer.files; // FileList
    fileList.innerHTML =3D &quot;&quot;;

    for (const file of files) {
      const li =3D document.createElement(&quot;li&quot;);
      li.textContent =3D `${file.name} (${(file.size / 1024).toFixed(1)} KB=
) =E2=80=94 ${file.type}`;
      fileList.appendChild(li);
    }

    // Upload with FormData
    const formData =3D new FormData();
    for (const file of files) {
      formData.append(&quot;files[]&quot;, file);
    }
    // fetch(&quot;/upload&quot;, { method: &quot;POST&quot;, body: formDat=
a });
  });
