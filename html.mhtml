"pl-kos">&gt;</span>
<span class=3D"pl-kos">&lt;</span><span class=3D"pl-ent">script</span> <spa=
n class=3D"pl-c1">src</span>=3D"<span class=3D"pl-s">app.js</span>"<span cl=
