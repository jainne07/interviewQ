rData"</code></td>
</tr>
<tr>
<td><code>target</code></td>
<td>The node that changed</td>
</tr>
<tr>
<td><code>addedNodes</code></td>
<td>NodeList of added nodes</td>
</tr>
<tr>
<td><code>removedNodes</code></td>
<td>NodeList of removed nodes</td>
</tr>
<tr>
<td><code>attributeName</code></td>
<td>Changed attribute name (for <code>attributes</code> type)</td>
</tr>
<tr>
<td><code>oldValue</code></td>
