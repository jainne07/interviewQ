</tr>
<tr>
<td><code>../about.html</code></td>
<td><code>https://example.com/blog/</code></td>
<td><code>https://example.com/about.html</code></td>
</tr>
<tr>
<td><code>/about.html</code></td>
<td><code>https://example.com/blog/</code></td>
<td><code>https://example.com/about.html</code></td>
</tr>
</tbody>
</table></markdown-accessiblity-table>
