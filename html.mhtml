n=3D"w" value=3D"// Select the target node to observe
const target =3D document.getElementById(&quot;app&quot;);

// Create an observer instance with a callback
const observer =3D new MutationObserver((mutationsList) =3D&gt; {
  for (const mutation of mutationsList) {
    if (mutation.type =3D=3D=3D &quot;childList&quot;) {
      console.log(&quot;Child nodes changed:&quot;, mutation.addedNodes, mu=
tation.removedNodes);
    } else if (mutation.type =3D=3D=3D &quot;attributes&quot;) {
      console.log(`Attribute &quot;${mutation.attributeName}&quot; changed`=
);
    } else if (mutation.type =3D=3D=3D &quot;characterData&quot;) {
      console.log(&quot;Text content changed:&quot;, mutation.target.data);
    }
  }
});

// Start observing
observer.observe(target, {
  childList: true,      // Watch for added/removed child nodes
  subtree: true,        // Watch all descendants, not just direct children
  attributes: true,     // Watch for attribute changes
  attributeFilter: [&quot;class&quot;, &quot;data-state&quot;], // Only the=
se attributes
  characterData: true,  // Watch text node changes
});

// Stop observing when done (prevents memory leaks)
observer.disconnect();" tabindex=3D"0" role=3D"button">
