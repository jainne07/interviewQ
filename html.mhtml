</tr>
</thead>
<tbody>
<tr>
<td><code>col</code></td>
<td>Header for its column</td>
</tr>
<tr>
<td><code>row</code></td>
<td>Header for its row</td>
</tr>
<tr>
<td><code>colgroup</code></td>
<td>Header for a group of columns</td>
</tr>
<tr>
<td><code>rowgroup</code></td>
<td>Header for a group of rows</td>
</tr>
</tbody>
</table></markdown-accessiblity-table>
<blockquote>
