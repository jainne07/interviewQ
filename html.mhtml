l-kos">)</span><span class=3D"pl-kos">;</span>
<span class=3D"pl-k">const</span> <span class=3D"pl-s1">shadow</span> <span=
 class=3D"pl-c1">=3D</span> <span class=3D"pl-s1">host</span><span class=3D=
"pl-kos">.</span><span class=3D"pl-en">attachShadow</span><span class=3D"pl=
-kos">(</span><span class=3D"pl-kos">{</span> <span class=3D"pl-c1">mode</s=
pan>: <span class=3D"pl-s">"open"</span> <span class=3D"pl-kos">}</span><sp=
an class=3D"pl-kos">)</span><span class=3D"pl-kos">;</span> <span class=3D"=
