n=3D"w" value=3D"// Classic Module Pattern (IIFE-based)
const BankAccount =3D (() =3D&gt; {
  // Private state =E2=80=94 not accessible from outside
  let _balance   =3D 0;
  const _history =3D [];

  function _log(action, amount) {
    _history.push({ action, amount, balance: _balance, ts: Date.now() });
  }

  // Public API
  return {
    deposit(amount) {
      if (amount &lt;=3D 0) throw new RangeError('Amount must be positive')=
;
      _balance +=3D amount;
      _log('deposit', amount);
      return this;
    },
    withdraw(amount) {
      if (amount &gt; _balance) throw new Error('Insufficient funds');
      _balance -=3D amount;
      _log('withdrawal', amount);
      return this;
    },
    getBalance()  { return _balance; },
    getHistory()  { return [..._history]; }, // defensive copy
  };
})();

BankAccount.deposit(500).deposit(200).withdraw(100);
console.log(BankAccount.getBalance()); // 600
