n=3D"w" value=3D"/**
 *  Promise chain vs async/await=20
 */

// Promise chain
function fetchUserChain(id) {
  return fetch(`/api/users/${id}`)
    .then(res =3D&gt; {
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    })
    .then(user =3D&gt; fetch(`/api/posts?userId=3D${user.id}`))
    .then(res =3D&gt; res.json());
}

// async/await =E2=80=94 identical semantics, far more readable
async function fetchUser(id) {
  const res =3D await fetch(`/api/users/${id}`);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const user =3D await res.json();

  const postsRes =3D await fetch(`/api/posts?userId=3D${user.id}`);
  return postsRes.json();
}

// async function always returns a Promise
const result =3D fetchUser(1);   // Promise&lt;...&gt;
console.log(result instanceof Promise); // true

// Return value wrapping
async function getValue() { return 42; }
getValue().then(console.log); // 42

// Thrown errors become rejections
async function fail() { throw new Error('oops'); }
fail().catch(err =3D&gt; console.error(err.message)); // 'oops'" tabindex=
