n=3D"w" value=3D"/**
 * Async generator: paginated API=20
 */

async function* fetchAllPages(baseUrl) {
  let page =3D 1;
  let hasMore =3D true;

  while (hasMore) {
    const res  =3D await fetch(`${baseUrl}?page=3D${page}&amp;limit=3D100`)=
;
    const { data, meta } =3D await res.json();

    yield data; // yield this page\'s array to the consumer

    hasMore =3D meta.page &lt; meta.totalPages;
    page++;
  }
}

// Consumer =E2=80=94 processes one page at a time, never holds all pages i=
n memory
async function processAllUsers() {
  for await (const page of fetchAllPages('/api/users')) {
    for (const user of page) {
      await sendWelcomeEmail(user); // process each user
    }
  }
