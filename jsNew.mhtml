n=3D"w" value=3D"/**
 * Decorator Pattern =E2=80=94 Composable request pipeline
 */

// Base component
class ApiRequest {
  async fetch(url) {
    const res =3D await globalThis.fetch(url);
    return res.json();
  }
}

// Decorator 1: Logging
class LoggingDecorator {
  #wrapped;
  constructor(request) { this.#wrapped =3D request; }

  async fetch(url) {
    console.log(`[LOG] Requesting: ${url}`);
    const start =3D Date.now();
    const result =3D await this.#wrapped.fetch(url);
    console.log(`[LOG] Completed in ${Date.now() - start}ms`);
    return result;
  }
}

// Decorator 2: Caching
class CachingDecorator {
  #wrapped;
  #cache =3D new Map();

  constructor(request) { this.#wrapped =3D request; }

  async fetch(url) {
    if (this.#cache.has(url)) {
      console.log(`[CACHE] Hit: ${url}`);
      return this.#cache.get(url);
    }
    const result =3D await this.#wrapped.fetch(url);
    this.#cache.set(url, result);
    return result;
  }
}

// Decorator 3: Retry
class RetryDecorator {
  #wrapped;
  #retries;

  constructor(request, retries =3D 3) {
    this.#wrapped =3D request;
    this.#retries =3D retries;
  }

  async fetch(url) {
    for (let attempt =3D 1; attempt &lt;=3D this.#retries; attempt++) {
      try {
        return await this.#wrapped.fetch(url);
      } catch (err) {
        if (attempt =3D=3D=3D this.#retries) throw err;
        console.log(`[RETRY] Attempt ${attempt} failed, retrying...`);
      }
    }
  }
}

// --- Compose decorators ---
const request =3D new RetryDecorator(
  new CachingDecorator(
    new LoggingDecorator(
      new ApiRequest()
    )
  ),
  3
);

// First call: logs + fetches + caches
await request.fetch('https://api.example.com/users');

// Second call: cache hit =E2=80=94 no network request
