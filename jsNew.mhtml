n=3D"w" value=3D"// custom Iterator
function numbers() {
  let n =3D 0;
  return {
    next: function () {
      n +=3D 10;
      return { value: n, done: false };
    }
  };
}

// Create an Iterator
const number =3D numbers();

console.log(number.next()); // {value: 10, done: false}
console.log(number.next()); // {value: 20, done: false}
console.log(number.next()); // {value: 30, done: false}" tabindex=3D"0" rol=
