n=3D"w" value=3D"/**
 * Singleton Pattern
 **/

let instance =3D null;

class Printer {

  constructor(pages) {
    this.display =3D function () {
      console.log(
        `You are connected to the printer. You want to print ${pages} pages=
.`
      );
    };
  }

  static getInstance(numOfpages) {
    if (!instance) {
      instance =3D new Printer(numOfpages);
    }
    return instance;
  }
}

var obj1 =3D Printer.getInstance(2);
console.log(obj1);
obj1.display();

var obj2 =3D Printer.getInstance(3);
console.log(obj2);
obj2.display();

