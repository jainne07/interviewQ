n=3D"w" value=3D"/**
 * Command Pattern =E2=80=94 Text editor with undo/redo
 */

// Receiver
class TextEditor {
  #content =3D '';

  insert(text, position) {
    this.#content =3D
      this.#content.slice(0, position) + text + this.#content.slice(positio=
n);
  }

  delete(position, length) {
    this.#content =3D
      this.#content.slice(0, position) + this.#content.slice(position + len=
gth);
  }

  getContent() { return this.#content; }
}

// Command interface (via duck typing)
class InsertCommand {
  #editor; #text; #position;

  constructor(editor, text, position) {
    this.#editor =3D editor;
    this.#text =3D text;
    this.#position =3D position;
  }

  execute() {
    this.#editor.insert(this.#text, this.#position);
  }

  undo() {
    this.#editor.delete(this.#position, this.#text.length);
  }
}

class DeleteCommand {
  #editor; #position; #length; #deletedText;

  constructor(editor, position, length) {
    this.#editor =3D editor;
    this.#position =3D position;
    this.#length =3D length;
  }

  execute() {
    // Capture text before deleting so undo can restore it
    this.#deletedText =3D this.#editor.getContent().slice(
      this.#position, this.#position + this.#length
    );
    this.#editor.delete(this.#position, this.#length);
  }

  undo() {
    this.#editor.insert(this.#deletedText, this.#position);
  }
}

// Invoker =E2=80=94 manages history
class CommandHistory {
  #history =3D [];
  #redoStack =3D [];

  execute(command) {
    command.execute();
    this.#history.push(command);
    this.#redoStack =3D []; // clear redo stack on new action
  }

  undo() {
    const command =3D this.#history.pop();
    if (!command) return;
    command.undo();
    this.#redoStack.push(command);
  }

  redo() {
    const command =3D this.#redoStack.pop();
    if (!command) return;
    command.execute();
    this.#history.push(command);
  }
}

// --- Usage ---
const editor =3D new TextEditor();
const history =3D new CommandHistory();

history.execute(new InsertCommand(editor, 'Hello', 0));
console.log(editor.getContent()); // 'Hello'

history.execute(new InsertCommand(editor, ' World', 5));
console.log(editor.getContent()); // 'Hello World'

history.undo();
console.log(editor.getContent()); // 'Hello'

history.redo();
console.log(editor.getContent()); // 'Hello World'

history.execute(new DeleteCommand(editor, 0, 5));
console.log(editor.getContent()); // ' World'

history.undo();
