 * Reflect
 */

const proxy =3D new Proxy({ count: 0 }, {
  set(target, key, value) {
    if (typeof value !=3D=3D 'number') throw new TypeError('Numbers only');
    console.log(`Setting ${key} =3D ${value}`);
    return Reflect.set(target, key, value); // forward to default behaviour
  },
  get(target, key) {
    console.log(`Reading ${key}`);
    return Reflect.get(target, key); // forward to default behaviour
