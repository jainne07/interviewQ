an> <span class=3D"pl-s1">reject</span><span class=3D"pl-kos">)</span> <spa=
n class=3D"pl-c1">=3D&gt;</span> <span class=3D"pl-kos">{</span>
    <span class=3D"pl-en">setTimeout</span><span class=3D"pl-kos">(</span><=
