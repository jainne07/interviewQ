l-kos">)</span><span class=3D"pl-kos">;</span>
<span class=3D"pl-smi">console</span><span class=3D"pl-kos">.</span><span c=
lass=3D"pl-en">log</span><span class=3D"pl-kos">(</span><span class=3D"pl-s=
1">objCopy</span><span class=3D"pl-kos">)</span><span class=3D"pl-kos">;</s=
