// Mediator
class ChatRoom {
  #users =3D new Map();

  register(user) {
    this.#users.set(user.name, user);
    user.setChatRoom(this);
  }

  send(message, fromUser, toUserName =3D null) {
    if (toUserName) {
      // Direct message
      const recipient =3D this.#users.get(toUserName);
      if (recipient) recipient.receive(message, fromUser.name);
    } else {
      // Broadcast
      this.#users.forEach((user) =3D&gt; {
        if (user !=3D=3D fromUser) user.receive(message, fromUser.name);
      });
    }
  }
}

// Colleague
class User {
  #chatRoom =3D null;
  name;

  constructor(name) { this.name =3D name; }

  setChatRoom(room) { this.#chatRoom =3D room; }

  send(message, toUserName =3D null) {
    console.log(`[${this.name}] sends: &quot;${message}&quot;`);
    this.#chatRoom.send(message, this, toUserName);
  }

  receive(message, fromName) {
    console.log(`[${this.name}] received from [${fromName}]: &quot;${messag=
e}&quot;`);
  }
}

// --- Usage ---
