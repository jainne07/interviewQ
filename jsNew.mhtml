// --- 1. Validation Proxy ---
function createValidatedUser(data) {
  return new Proxy(data, {
    set(target, prop, value) {
      if (prop =3D=3D=3D 'age') {
        if (typeof value !=3D=3D 'number' || value &lt; 0 || value &gt; 150=
) {
          throw new RangeError(`Invalid age: ${value}`);
        }
      }
      if (prop =3D=3D=3D 'email') {
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
          throw new TypeError(`Invalid email: ${value}`);
        }
      }
      target[prop] =3D value;
      return true; // required by Proxy set trap
    }
  });
}

