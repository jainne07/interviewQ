class ConfigManager {
  static #instance =3D null;

  constructor() {
    // Prevent direct instantiation if an instance already exists
    if (ConfigManager.#instance) {
      return ConfigManager.#instance;
    }

    this.settings =3D { theme: &quot;dark&quot; };
    ConfigManager.#instance =3D this;
    Object.freeze(this);
  }

