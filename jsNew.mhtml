  }
  res.locals.csrfToken =3D req.session.csrfToken;
  next();
});

// Server: validate token on state-changing requests
function csrfProtect(req, res, next) {
  const token =3D req.headers['x-csrf-token'] ?? req.body?._csrf;
  if (!token || token !=3D=3D req.session.csrfToken) {
    return res.status(403).json({ error: 'Invalid CSRF token' });
  }
  next();
}

