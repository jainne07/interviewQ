class SlidingWindowRateLimiter {
  constructor(maxRequests, windowSizeInMs) {
    this.maxRequests =3D maxRequests;
    this.windowSize =3D windowSizeInMs;
    this.timestamps =3D []; // Stores request timestamps
  }

  allowRequest() {
    const now =3D Date.now();

    // Remove timestamps outside the current window
    while (this.timestamps.length &gt; 0 &amp;&amp; this.timestamps[0] &lt;=
=3D now - this.windowSize) {
      this.timestamps.shift();
    }

    // Check capacity
    if (this.timestamps.length &lt; this.maxRequests) {
      this.timestamps.push(now);
      return true;
    }

    return false;
  }
}

// Example usage: 3 requests per 2 seconds
