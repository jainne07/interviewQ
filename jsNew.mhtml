n=3D"w" value=3D"class PubSub {
  constructor() {
    this.events =3D {};
  }

  // Add a subscriber to a specific event topic
  subscribe(event, callback) {
    if (!this.events[event]) {
      this.events[event] =3D [];
    }
    this.events[event].push(callback);

    // Return an unsubscribe function for easy cleanup
    return () =3D&gt; {
      this.events[event] =3D this.events[event].filter(cb =3D&gt; cb !=3D=
=3D callback);
    };
  }

  // Publish an event, executing all registered callbacks with data
  publish(event, data) {
    if (!this.events[event]) return;
    this.events[event].forEach(callback =3D&gt; callback(data));
  }
}

