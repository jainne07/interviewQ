<span class=3D"pl-c">// const p =3D new Person('Alice'); // ReferenceError:=
 Cannot access 'Person' before initialization</span>

<span class=3D"pl-k">class</span> <span class=3D"pl-v">Person</span> <span =
class=3D"pl-kos">{</span>
  <span class=3D"pl-en">constructor</span><span class=3D"pl-kos">(</span><s=
pan class=3D"pl-s1">name</span><span class=3D"pl-kos">)</span> <span class=
