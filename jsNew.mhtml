n=3D"w" value=3D"/**
 * Observer Pattern
 */

class Subject {
  constructor() {
    this.observers =3D [];
  }

  subscribe(observer) {
    this.observers.push(observer);
  }

  unsubscribe(observer) {
    this.observers =3D this.observers.filter(obs =3D&gt; obs !=3D=3D observ=
er);
  }

  notify(data) {
    // Direct synchronous communication
    this.observers.forEach(observer =3D&gt; observer.update(data));
  }
}

// Concrete Observer
const loggingObserver =3D {
  update: (data) =3D&gt; console.log(`Logged update: ${data}`)
};

// Usage
