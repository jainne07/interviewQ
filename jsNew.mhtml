    <span class=3D"pl-c1">c</span>: <span class=3D"pl-c1">20</span>
  <span class=3D"pl-kos">}</span>
<span class=3D"pl-kos">}</span><span class=3D"pl-kos">;</span>

<span class=3D"pl-k">let</span> <span class=3D"pl-s1">newObj</span> <span c=
