then</span><span class=3D"pl-kos">(</span><span class=3D"pl-smi">module</sp=
an> <span class=3D"pl-c1">=3D&gt;</span> <span class=3D"pl-kos">{</span> ..=
. <span class=3D"pl-kos">}</span><span class=3D"pl-kos">)</span><span class=
=3D"pl-kos">;</span>

