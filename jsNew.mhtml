 */
function memoize(fn, options =3D {}) {
  const {=20
    maxSize =3D 1000,=20
    keyResolver =3D (...args) =3D&gt; JSON.stringify(args)=20
  } =3D options;

  // Map maintains insertion order, making it perfect for LRU eviction
  const cache =3D new Map();

  return function (...args) {
    const key =3D keyResolver(...args);

    if (cache.has(key)) {
      // Refresh key order for LRU policy by moving it to the end
      const value =3D cache.get(key);
      cache.delete(key);
      cache.set(key, value);
      return value;
    }

    // Compute the expensive result
    const result =3D fn.apply(this, args);

    // Evict the oldest item if the cache limit is reached
    if (cache.size &gt;=3D maxSize) {
      const oldestKey =3D cache.keys().next().value;
      cache.delete(oldestKey);
    }

    cache.set(key, result);
    return result;
  };
