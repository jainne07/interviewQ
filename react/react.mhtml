n=3D"w" value=3D"/**
 * POST Request using Axios
 */
import { useState } from &quot;react&quot;;
import axios, { AxiosError } from &quot;axios&quot;;

interface CreatedUser {
  id: number;
  name: string;
}

export default function CreateUser() {
  const [name, setName] =3D useState(&quot;&quot;);
  const [result, setResult] =3D useState&lt;CreatedUser | null&gt;(null);
  const [error, setError] =3D useState(&quot;&quot;);

  const handleSubmit =3D async (event: React.SubmitEvent&lt;HTMLFormElement=
&gt;) =3D&gt; {
    event.preventDefault();
    setError(&quot;&quot;);
    setResult(null);

    try {
      const response =3D await axios.post(
        &quot;https://jsonplaceholder.typicode.com/users&quot;,
        { name } // request body
      );
      setResult(response.data);
      setName(&quot;&quot;);
    } catch (err) {
      const axiosErr =3D err as AxiosError;
      setError(&quot;Failed to create user&quot; + (axiosErr.response ? `: =
${axiosErr.response.statusText}` : &quot;&quot;));
    }
  };

  return (
    &lt;div&gt;
      &lt;h2&gt;Create User&lt;/h2&gt;

      &lt;form onSubmit=3D{handleSubmit}&gt;
        &lt;input
          value=3D{name}
          onChange=3D{(e) =3D&gt; setName(e.target.value)}
          placeholder=3D&quot;Enter name&quot;
          required
        /&gt;
        &lt;button type=3D&quot;submit&quot;&gt;Submit&lt;/button&gt;
      &lt;/form&gt;

      {error &amp;&amp; &lt;p&gt;{error}&lt;/p&gt;}

      {result &amp;&amp; (
        &lt;div&gt;
          &lt;h3&gt;Created:&lt;/h3&gt;
          &lt;p&gt;ID: {result.id}&lt;/p&gt;
          &lt;p&gt;Name: {result.name}&lt;/p&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
}" tabindex=3D"0" role=3D"button">
