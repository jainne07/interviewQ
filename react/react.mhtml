n=3D"w" value=3D"import { useState, useEffect } from 'react';

export default function UserList() {
  const [users, setUsers] =3D useState([]);
  const [loading, setLoading] =3D useState(true);
  const [error, setError] =3D useState(null);

  useEffect(() =3D&gt; {
    fetch('https://jsonplaceholder.typicode.com/users')
      .then(res =3D&gt; res.json())
      .then(data =3D&gt; {
        setUsers(data);
        setLoading(false);
      })
      .catch(err =3D&gt; {
        setError(err.message);
        setLoading(false);
      });
  }, []);

  if (loading) return &lt;p&gt;Loading...&lt;/p&gt;;
  if (error)   return &lt;p&gt;Error: {error}&lt;/p&gt;;

  return (
    &lt;ul&gt;
      {users.map(user =3D&gt; (
        &lt;li key=3D{user.id}&gt;{user.name}&lt;/li&gt;
      ))}
    &lt;/ul&gt;
  );
}" tabindex=3D"0" role=3D"button">
