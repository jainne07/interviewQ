n=3D"w" value=3D"// AuthService.js
const API_URL =3D '/api';

export async function login(email, password) {
  const response =3D await fetch(`${API_URL}/auth/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password }),
  });

  if (!response.ok) throw new Error('Login failed');

  const { token, user } =3D await response.json();

  // Store token in memory (most secure) or sessionStorage
  // Avoid localStorage for sensitive tokens due to XSS risk
  sessionStorage.setItem('authToken', token);
  return user;
}

export function getToken() {
  return sessionStorage.getItem('authToken');
}

export function logout() {
  sessionStorage.removeItem('authToken');
}

// Axios interceptor to attach token to every request
import axios from 'axios';

axios.interceptors.request.use((config) =3D&gt; {
  const token =3D getToken();
  if (token) {
    config.headers.Authorization =3D `Bearer ${token}`;
  }
  return config;
});" tabindex=3D"0" role=3D"button">
