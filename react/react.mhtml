n=3D"w" value=3D"import { useState, useMemo } from 'react';

const fruits =3D ['apple', 'orange', 'banana'];

/**
 * App component that renders a searchable fruit list.
 * Uses `useMemo` to memoize the filtered results, recomputing
 * only when the search query changes.
 */
function App() {
  const [query, setQuery] =3D useState('');

  const filteredFruits =3D useMemo(
    () =3D&gt; fruits.filter((fruit) =3D&gt; fruit.includes(query.toLowerCa=
se())),
    [query]
  );

  return (
    &lt;div&gt;
      &lt;input
        type=3D&quot;text&quot;
        placeholder=3D&quot;Search fruits...&quot;
        value=3D{query}
        onChange=3D{(e) =3D&gt; setQuery(e.target.value)}
      /&gt;
      &lt;ul&gt;
        {filteredFruits.map((fruit) =3D&gt; (
          &lt;li key=3D{fruit}&gt;{fruit}&lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/div&gt;
  );
}

export default App;" tabindex=3D"0" role=3D"button">
