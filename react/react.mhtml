verflow-auto" dir=3D"auto"><pre><span class=3D"pl-c">/**</span>
<span class=3D"pl-c"> * componentDidMount() in Class Component</span>
<span class=3D"pl-c"> */</span>
<span class=3D"pl-k">import</span> <span class=3D"pl-v">React</span><span c=
lass=3D"pl-kos">,</span> <span class=3D"pl-kos">{</span> <span class=3D"pl-=
v">Component</span> <span class=3D"pl-kos">}</span> <span class=3D"pl-k">fr=
om</span> <span class=3D"pl-s">"react"</span><span class=3D"pl-kos">;</span=
>

<span class=3D"pl-k">export</span> <span class=3D"pl-k">default</span> <spa=
