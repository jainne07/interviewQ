 */
import { createContext, useContext } from 'react';

interface CountContextType {
  count: number;
  increase: () =3D&gt; void;
  decrease: () =3D&gt; void;
}

export const CountContext =3D createContext&lt;CountContextType | undefined=
&gt;(undefined);

function Counter() {
  const { count, increase, decrease } =3D useContext(CountContext) as Count=
ContextType;
  return (
    &lt;h2&gt;
      &lt;button onClick=3D{decrease}&gt;Decrement&lt;/button&gt;
      &lt;span className=3D&quot;count&quot;&gt; {count} &lt;/span&gt;
      &lt;button onClick=3D{increase}&gt;Increment&lt;/button&gt;
    &lt;/h2&gt;
  );
}

