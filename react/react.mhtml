interface CounterState {
  count: number;
  step: number;
}

type CounterAction =3D
  | { type: 'INCREMENT' }
  | { type: 'DECREMENT' }
  | { type: 'RESET' }
  | { type: 'SET_STEP'; payload: number };

// Reducer with full type safety
function counterReducer(state: CounterState, action: CounterAction): Counte=
rState {
  switch (action.type) {
    case 'INCREMENT':
      return { ...state, count: state.count + state.step };
    case 'DECREMENT':
      return { ...state, count: state.count - state.step };
    case 'RESET':
      return { ...state, count: 0 };
    case 'SET_STEP':
      return { ...state, step: action.payload };
    default:
      return state;
  }
}

function Counter() {
  const [state, dispatch] =3D useReducer(counterReducer, { count: 0, step: =
1 });

  return (
    &lt;div&gt;
      &lt;p&gt;Count: {state.count}&lt;/p&gt;
      &lt;button onClick=3D{() =3D&gt; dispatch({ type: 'INCREMENT' })}&gt;=
+&lt;/button&gt;
      &lt;button onClick=3D{() =3D&gt; dispatch({ type: 'DECREMENT' })}&gt;=
-&lt;/button&gt;
      &lt;button onClick=3D{() =3D&gt; dispatch({ type: 'SET_STEP', payload=
: 5 })}&gt;Set Step 5&lt;/button&gt;
    &lt;/div&gt;
  );
