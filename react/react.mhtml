checked}`
    );
  };

  return (
    &lt;form onSubmit=3D{handleSubmit}&gt;
      &lt;input
        ref=3D{nameRef}
        type=3D&quot;text&quot;
        defaultValue=3D&quot;Pradeep&quot;   // initial value only
      /&gt;

      &lt;label&gt;
        &lt;input
          ref=3D{newsletterRef}
          type=3D&quot;checkbox&quot;
          defaultChecked=3D{true}  // initial checked state
        /&gt;
        Subscribe
      &lt;/label&gt;

      &lt;button type=3D&quot;submit&quot;&gt;Submit&lt;/button&gt;
    &lt;/form&gt;
  );
}" tabindex=3D"0" role=3D"button">
