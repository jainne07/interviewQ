  connectedCallback() {
    const mountPoint =3D document.createElement('span');
    this.attachShadow({ mode: 'open' }).appendChild(mountPoint);

    const name =3D this.getAttribute('name');
    const url =3D 'https://www.google.com/search?q=3D' + encodeURIComponent=
(name);
    createRoot(mountPoint).render(&lt;a href=3D{url}&gt;{name}&lt;/a&gt;);
  }
}
