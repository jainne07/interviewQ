import { createBrowserRouter, RouterProvider, redirect } from &quot;react-r=
outer-dom&quot;;

const router =3D createBrowserRouter([
  {
    path: &quot;/&quot;,
    // loader runs before rendering; returning redirect() sends the user el=
sewhere
    loader: () =3D&gt; redirect(&quot;/home&quot;),
  },
  {
    path: &quot;/home&quot;,
    element: &lt;h1&gt;Home Page&lt;/h1&gt;,
  },
  {
    path: &quot;/about&quot;,
    element: &lt;h1&gt;About Page&lt;/h1&gt;,
  },
]);

function AppWithLoaderRedirect() {
  return &lt;RouterProvider router=3D{router} /&gt;;
}
