import React from &quot;react&quot;;
import rafSchedule from &quot;raf-schd&quot;;

type Point =3D { x: number; y: number };
type Props =3D { onScroll: (point: Point) =3D&gt; void };

export default class App extends React.Component&lt;Props&gt; {
  scheduleUpdate =3D rafSchedule((point: Point) =3D&gt; this.props.onScroll=
(point));

  constructor(props: Props) {
    super(props);
    this.handleScroll =3D this.handleScroll.bind(this);
  }

  handleScroll(e: React.UIEvent&lt;HTMLDivElement&gt; &amp; { clientX: numb=
er; clientY: number }) {
    // When we receive a scroll event, schedule an update.
    // If we receive many updates within a frame, we'll only publish the la=
test value.
    this.scheduleUpdate({ x: e.clientX, y: e.clientY });
  }

  componentWillUnmount() {
    // Cancel any pending updates since we're unmounting.
    this.scheduleUpdate.cancel();
  }

  render() {
    return (
      &lt;div style=3D{{ overflow: &quot;scroll&quot; }} onScroll=3D{this.h=
andleScroll}&gt;
        &lt;img src=3D&quot;https://picsum.photos/800/600&quot; alt=3D&quot=
;Nature&quot; /&gt;
      &lt;/div&gt;
    );
  }
}" tabindex=3D"0" role=3D"button">
