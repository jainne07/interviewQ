        setLoading(true);
        const res =3D await fetch(&quot;https://jsonplaceholder.typicode.co=
m/users&quot;);
        if (!res.ok) throw new Error(&quot;Request failed&quot;);
        const data =3D await res.json();
        if (!ignore) setUsers(data);
      } catch (err) {
        if (!ignore) setError(err instanceof Error ? err.message : &quot;Un=
known error&quot;);
      } finally {
        if (!ignore) setLoading(false);
