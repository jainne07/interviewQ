n=3D"w" value=3D"import React from 'react'

const users =3D [
  { id: '101', name: 'Dennis' },
  { id: '102', name: 'Alice' },
  { id: '103', name: 'Bob' },
  { id: '104', name: 'Carol' },
  { id: '105', name: 'Dave' }
]

/**
 * App component that renders a searchable list of users.
 * Uses `useMemo` to memoize the filtered user list, recomputing
 * only when the search query changes.
 */
const App =3D () =3D&gt; {
  const [search, setSearch] =3D React.useState('')

  const filteredUsers =3D React.useMemo(
    () =3D&gt; users.filter((user) =3D&gt; user.name.toLowerCase().includes=
(search.toLowerCase())),
    [search]
  )

  return (
    &lt;div&gt;
      &lt;input
        type=3D&quot;text&quot;
        value=3D{search}
        onChange=3D{(e) =3D&gt; setSearch(e.target.value)}
        placeholder=3D&quot;Search users&quot;
      /&gt;
      &lt;ul&gt;
        {filteredUsers.map((user) =3D&gt; (
          &lt;li key=3D{user.id}&gt;{user.name}&lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/div&gt;
  )
}

export default App" tabindex=3D"0" role=3D"button">
