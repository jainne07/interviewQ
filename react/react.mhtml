n=3D"w" value=3D"import { useState } from 'react';

const initialFruits =3D ['Banana', 'Apple', 'Cherry', 'Mango'];

export default function FruitList() {
  const [fruits, setFruits] =3D useState(initialFruits);

  const sortAscending =3D () =3D&gt; {
    //  Spread creates a new array =E2=80=94 original state is untouched
    setFruits([...fruits].sort((a, b) =3D&gt; a.localeCompare(b)));
  };

  const sortDescending =3D () =3D&gt; {
    setFruits([...fruits].sort((a, b) =3D&gt; b.localeCompare(a)));
  };

  return (
    &lt;&gt;
      &lt;button onClick=3D{sortAscending}&gt;Sort A =E2=86=92 Z&lt;/button=
&gt;
      &lt;button onClick=3D{sortDescending}&gt;Sort Z =E2=86=92 A&lt;/butto=
n&gt;
      &lt;ul&gt;
        {fruits.map((fruit) =3D&gt; (
          &lt;li key=3D{fruit}&gt;{fruit}&lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/&gt;
  );
}" tabindex=3D"0" role=3D"button">
