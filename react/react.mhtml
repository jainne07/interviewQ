import PlayerContent from &quot;./PlayerContent&quot;;
import PlayerDetails from &quot;./PlayerDetails&quot;;

export default class App extends React.Component {
  constructor(props) {
    super(props);
    this.state =3D { selectedPlayer: [0, 0], playerName: &quot;&quot; };
    this.updateSelectedPlayer =3D this.updateSelectedPlayer.bind(this);
  }
  updateSelectedPlayer(id, name) {
    const arr =3D [0, 0, 0, 0];
    arr[id] =3D 1;
    this.setState({
      playerName: name,
      selectedPlayer: arr
    });
  }
  render() {
    return (
      &lt;div&gt;
        &lt;PlayerContent
          active=3D{this.state.selectedPlayer[0]}
          clickHandler=3D{this.updateSelectedPlayer}
          id=3D{0}
          name=3D&quot;Player 1&quot;
        /&gt;
        &lt;PlayerContent
          active=3D{this.state.selectedPlayer[1]}
          clickHandler=3D{this.updateSelectedPlayer}
          id=3D{1}
          name=3D&quot;Player 2&quot;
        /&gt;
        &lt;PlayerDetails name=3D{this.state.playerName} /&gt;
      &lt;/div&gt;
    );
  }
