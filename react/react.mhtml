  &lt;/div&gt;
);

// PropTypes validation for the prop object
Component.propTypes =3D {
  badge: PropTypes.shape({
    src: PropTypes.string.isRequired,
    alt: PropTypes.string.isRequired
  })
};

const App =3D () =3D&gt; (
  &lt;div&gt;
    &lt;Component badge=3D{{ src: &quot;horse.png&quot;, alt: &quot;Running=
 Horse&quot; }} /&gt;
    {/*&lt;Component badge=3D{{src:null, alt: 'this one gives an error'}}/&=
