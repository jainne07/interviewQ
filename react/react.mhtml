import { useAuth } from './AuthContext';

// Protected Route component
function ProtectedRoute({ allowedRoles }) {
  const { isAuthenticated, user } =3D useAuth();
  const location =3D useLocation();

  if (!isAuthenticated) {
    // Redirect to login, preserving intended destination
    return &lt;Navigate to=3D&quot;/login&quot; state=3D{{ from: location }=
} replace /&gt;;
  }

  if (allowedRoles &amp;&amp; !allowedRoles.includes(user.role)) {
    return &lt;Navigate to=3D&quot;/unauthorized&quot; replace /&gt;;
  }

  return &lt;Outlet /&gt;;
}

// App Router Setup
function App() {
  return (
    &lt;Routes&gt;
      {/* Public routes */}
      &lt;Route path=3D&quot;/login&quot; element=3D{&lt;LoginPage /&gt;} /=
&gt;
      &lt;Route path=3D&quot;/register&quot; element=3D{&lt;RegisterPage /&=
gt;} /&gt;

      {/* Protected routes - any authenticated user */}
      &lt;Route element=3D{&lt;ProtectedRoute /&gt;}&gt;
        &lt;Route path=3D&quot;/dashboard&quot; element=3D{&lt;Dashboard /&=
gt;} /&gt;
        &lt;Route path=3D&quot;/profile&quot; element=3D{&lt;Profile /&gt;}=
 /&gt;
      &lt;/Route&gt;

      {/* Role-based protected routes */}
      &lt;Route element=3D{&lt;ProtectedRoute allowedRoles=3D{['admin']} /&=
gt;}&gt;
        &lt;Route path=3D&quot;/admin&quot; element=3D{&lt;AdminPanel /&gt;=
} /&gt;
      &lt;/Route&gt;
    &lt;/Routes&gt;
  );
}

// LoginPage redirects back to intended destination
function LoginPage() {
  const { login } =3D useAuth();
  const navigate =3D useNavigate();
  const location =3D useLocation();
  const from =3D location.state?.from?.pathname || '/dashboard';

  const handleSubmit =3D async (e) =3D&gt; {
    e.preventDefault();
    await login(email, password);
    navigate(from, { replace: true });
  };
