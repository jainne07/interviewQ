n=3D"w" value=3D"/**
 * Demonstrates useCallback() to memoize a function reference.
 * The memoized `increment` callback is only recreated when `counter` chang=
es, preventing unnecessary re-renders and function calls.
 */
import { useState, useCallback, useEffect } from &quot;react&quot;;

const count =3D new Set();

function App() {
  const [counter, setCounter] =3D useState(0);

  const increment =3D useCallback(() =3D&gt; {
    setCounter(counter + 1);
  }, [counter]);

  useEffect(() =3D&gt; {
    count.add(increment);
    console.log(count.size);
  }, [increment]);

  return (
    &lt;&gt;
      &lt;h1&gt;useCallback Hook Example&lt;/h1&gt;
      &lt;h2&gt;Function Call: {count.size}&lt;/h2&gt;
      &lt;button onClick=3D{increment}&gt;Increment&lt;/button&gt;
    &lt;/&gt;
  );
}

export default App;" tabindex=3D"0" role=3D"button">
