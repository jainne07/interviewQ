n=3D"w" value=3D"import { useState, useCallback, useMemo } from 'react';

function ParentComponent() {
  const [count, setCount] =3D useState(0);
  const [items] =3D useState(['apple', 'banana', 'cherry', 'date']);

  // useCallback =E2=80=94 memoizes the function itself
  // The same function reference is returned until 'count' changes
  const handleClick =3D useCallback(() =3D&gt; {
    console.log('Clicked, count is:', count);
  }, [count]);

  // useMemo =E2=80=94 memoizes the return value of the function
  // Only re-runs the filter when 'items' or 'count' changes
  const filteredItems =3D useMemo(
    () =3D&gt; items.filter(item =3D&gt; item.length &gt; count),
    [items, count]
  );

  return (
    &lt;div&gt;
      &lt;button onClick=3D{() =3D&gt; setCount(c =3D&gt; c + 1)}&gt;Count:=
 {count}&lt;/button&gt;
      &lt;ChildButton onClick=3D{handleClick} /&gt;   {/* Won\'t re-render =
unless count changes */}
      &lt;ul&gt;{filteredItems.map(i =3D&gt; &lt;li key=3D{i}&gt;{i}&lt;/li=
&gt;)}&lt;/ul&gt;
    &lt;/div&gt;
  );
}

const ChildButton =3D React.memo(({ onClick }) =3D&gt; {
  console.log('ChildButton rendered');
  return &lt;button onClick=3D{onClick}&gt;Click me&lt;/button&gt;;
});" tabindex=3D"0" role=3D"button">
