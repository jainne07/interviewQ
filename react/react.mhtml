n=3D"w" value=3D"import { useState } from 'react';

const initialTasks =3D [
  { id: 1, title: 'Buy groceries', done: false },
  { id: 2, title: 'Read a book',   done: false },
  { id: 3, title: 'Go for a walk', done: false },
];

export default function TaskList() {
  const [tasks, setTasks] =3D useState(initialTasks);

  const toggleDone =3D (id: number) =3D&gt; {
    setTasks(prevTasks =3D&gt;
      prevTasks.map(task =3D&gt;
        task.id =3D=3D=3D id ? { ...task, done: !task.done } : task
      )
    );
  };

  return (
    &lt;ul&gt;
      {tasks.map(task =3D&gt; (
        &lt;li key=3D{task.id}&gt;
          &lt;span style=3D{{ textDecoration: task.done ? 'line-through' : =
'none' }}&gt;
            {task.title}
          &lt;/span&gt;
          &lt;button onClick=3D{() =3D&gt; toggleDone(task.id)}&gt;
            {task.done ? 'Undo' : 'Done'}
          &lt;/button&gt;
        &lt;/li&gt;
      ))}
    &lt;/ul&gt;
  );
}" tabindex=3D"0" role=3D"button">
