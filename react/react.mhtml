n=3D"w" value=3D"/**
 * React Context API
 */
import { useState, useContext, createContext, useMemo, useCallback } from &=
quot;react&quot;;

interface MyContextType {
  count: number;
  increment: () =3D&gt; void;
}

const MyContext =3D createContext&lt;MyContextType | undefined&gt;(undefine=
d);

/**
 * Child Component
 */
const ChildComponent =3D () =3D&gt; {
  const { count, increment } =3D useContext(MyContext) as MyContextType;

  return (
    &lt;div&gt;
      &lt;p&gt;Count: {count}&lt;/p&gt;
      &lt;button onClick=3D{increment}&gt;Increment&lt;/button&gt;
    &lt;/div&gt;
  );
};

/**
 * App Component
 *=20
