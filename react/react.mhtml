n=3D"w" value=3D"/**
 * Pass parameter to an event handler
 */
import { useState } from 'react';

const A =3D 65; // ASCII character code

const App =3D () =3D&gt; {
  const [justClicked, setJustClicked] =3D useState&lt;string | null&gt;(nul=
l);
  const [letters] =3D useState(Array.from({ length: 26 }, (_, i) =3D&gt; St=
ring.fromCodePoint(A + i)));

  const handleClick =3D (letter: string) =3D&gt; {
    setJustClicked(letter);
  };

  return (
    &lt;&gt;
      Just clicked: {justClicked}
      &lt;ul&gt;
        {letters.map((letter) =3D&gt; (
          &lt;li key=3D{letter}&gt;
            &lt;button type=3D&quot;button&quot; onClick=3D{() =3D&gt; hand=
leClick(letter)}&gt;
              {letter}
            &lt;/button&gt;
          &lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/&gt;
