  useEffect(() =3D&gt; {
    const handleResize =3D () =3D&gt; {
      setWindowSize({
        width: window.innerWidth,
        height: window.innerHeight,
      });
    };

    handleResize();
    window.addEventListener('resize', handleResize);
    return () =3D&gt; window.removeEventListener('resize', handleResize);
  }, []);

  return windowSize;
