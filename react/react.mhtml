import { useSuspenseQuery } from '@tanstack/react-query';

// Child component =E2=80=94 suspends automatically while fetching
function UserList() {
  const { data: users } =3D useSuspenseQuery({
    queryKey: ['users'],
    queryFn: () =3D&gt;
      fetch('https://jsonplaceholder.typicode.com/users').then(r =3D&gt; r.=
json()),
  });

  return (
    &lt;ul&gt;
      {users.map(user =3D&gt; (
        &lt;li key=3D{user.id}&gt;{user.name}&lt;/li&gt;
      ))}
    &lt;/ul&gt;
  );
}

// Parent wraps the list in Suspense and provides a fallback
export default function App() {
  return (
    &lt;Suspense fallback=3D{&lt;p&gt;Loading users...&lt;/p&gt;}&gt;
      &lt;UserList /&gt;
    &lt;/Suspense&gt;
  );
}" tabindex=3D"0" role=3D"button">
