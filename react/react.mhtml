  return (
    &lt;div&gt;
      &lt;CustomInput ref=3D{inputRef} /&gt;
      &lt;button onClick=3D{() =3D&gt; inputRef.current?.focus()}&gt;Focus&=
lt;/button&gt;
      &lt;button onClick=3D{() =3D&gt; inputRef.current?.clear()}&gt;Clear&=
lt;/button&gt;
    &lt;/div&gt;
  )
}

