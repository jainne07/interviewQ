export function Counter() {
  const [count, setCount] =3D useState(0);

  useEffect(() =3D&gt; {
    // Subscribe to changes
    const subscription =3D counterStore.counter$.subscribe(setCount);

    // CRITICAL: Clean up subscription on unmount
    return () =3D&gt; subscription.unsubscribe();
