export default function App() {
  const [count, setCount] =3D useState(0);
 =20
  const increment =3D useCallback(() =3D&gt; {
    setCount(prev =3D&gt; prev + 1);
  }, []);

  const contextValue =3D useMemo(() =3D&gt; ({ count, increment }), [count,=
 increment]);

  return (
    &lt;MyContext.Provider value=3D{contextValue}&gt;
        &lt;ChildComponent /&gt;
    &lt;/MyContext.Provider&gt;
  );
