const Parent =3D () =3D&gt; {
  const [isOpen, setIsOpen] =3D React.useState(false);

  const toggleChild =3D () =3D&gt; {
    setIsOpen((prevValue) =3D&gt; !prevValue);
  };

  return (
    &lt;div&gt;
      &lt;button onClick=3D{toggleChild}&gt;Click Me&lt;/button&gt;
      {/* Pass a callback to Child */}
