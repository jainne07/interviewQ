 * Refs
 */
import { useRef, useState } from &quot;react&quot;;

function App() {
  // create a ref to store the textInput DOM element
  const textInput =3D useRef&lt;HTMLInputElement&gt;(null);
  const [value, setValue] =3D useState('');

  // Set the state for the ref
  const handleSubmit =3D (e: React.SubmitEvent&lt;HTMLFormElement&gt;) =3D&=
gt; {
    e.preventDefault();
    setValue(textInput.current?.value ?? '');
  };

  return (
    &lt;div&gt;
      &lt;h1&gt;React Ref - useRef Example&lt;/h1&gt;
      &lt;h3&gt;Value: {value}&lt;/h3&gt;
      &lt;form onSubmit=3D{handleSubmit}&gt;
        {/** Call the ref on &lt;input&gt; so we can use it to update the &=
lt;h3&gt; value **/}
        &lt;input type=3D&quot;text&quot; ref=3D{textInput} /&gt;
        &lt;button&gt;Submit&lt;/button&gt;
      &lt;/form&gt;
    &lt;/div&gt;
  );
}

export default App;" tabindex=3D"0" role=3D"button">
