import { GoogleOAuthProvider, GoogleLogin } from '@react-oauth/google';
import { jwtDecode } from 'jwt-decode';

function App() {
  return (
    &lt;GoogleOAuthProvider clientId=3D{import.meta.env.VITE_GOOGLE_CLIENT_=
ID}&gt;
      &lt;LoginPage /&gt;
    &lt;/GoogleOAuthProvider&gt;
  );
}

function LoginPage() {
  const { login } =3D useAuth();

  const handleGoogleSuccess =3D async (credentialResponse) =3D&gt; {
    // Decode the Google JWT to get user info
    const decoded =3D jwtDecode(credentialResponse.credential);
   =20
    // Send the credential to your backend for verification
    const response =3D await fetch('/api/auth/google', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ credential: credentialResponse.credential }),
    });

    const { token, user } =3D await response.json();
    login(token, user);
  };

  return (
    &lt;div&gt;
      &lt;h1&gt;Sign In&lt;/h1&gt;
      &lt;GoogleLogin
        onSuccess=3D{handleGoogleSuccess}
        onError=3D{() =3D&gt; console.log('Login Failed')}
      /&gt;
    &lt;/div&gt;
  );
}" tabindex=3D"0" role=3D"button">
