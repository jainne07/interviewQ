n=3D"w" value=3D"/**
 * ContextType Example
 *
 * Demonstrates class-based context consumption using static contextType.
 * ThemeContext provides a &quot;dark&quot; theme value to the Header compo=
nent,
 * which reads it via this.context.
 */
import React from &quot;react&quot;;

const ThemeContext =3D React.createContext(&quot;light&quot;);

class Header extends React.Component {
  static readonly contextType =3D ThemeContext;

  componentDidMount() {
    console.log(&quot;Current theme:&quot;, this.context);
  }

  render() {
    const theme =3D this.context as string;
    return &lt;h1&gt;Theme: {theme}&lt;/h1&gt;;
  }
}

export default function App() {
  return (
    &lt;ThemeContext.Provider value=3D&quot;dark&quot;&gt;
      &lt;Header /&gt;
    &lt;/ThemeContext.Provider&gt;
  );
