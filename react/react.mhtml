  // You will run count() only once after 100ms
  handleDebounce =3D _.debounce(() =3D&gt; this.handleCount(), 100);

  // You will run count() every 200ms
  handleThrottle =3D _.throttle(() =3D&gt; this.handleCount(), 200);

