n=3D"w" value=3D"import { useState, useEffect } from 'react';

function Timer() {
  const [seconds, setSeconds] =3D useState(0);

  useEffect(() =3D&gt; {
    // 1. Set the interval to 1000ms (1 second)
    const interval =3D setInterval(() =3D&gt; {
      // Use functional update to avoid closure issues with 'seconds'
      setSeconds(prev =3D&gt; prev + 1);
    }, 1000);

    // 2. Clean up the interval on unmount
    return () =3D&gt; clearInterval(interval);
  }, []); // Empty array ensures this only runs once

  return &lt;div&gt;Time elapsed: {seconds} seconds&lt;/div&gt;;
}" tabindex=3D"0" role=3D"button">
