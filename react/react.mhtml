function RadioGroup({ name, children }) {
  return (
    &lt;div className=3D&quot;radio-group&quot;&gt;
      {/*=20
        We map through children and &quot;clone&quot; each one,=20
        merging the 'name' prop into them.=20
      */}
      {Children.map(children, (child) =3D&gt; {
        if (React.isValidElement(child)) {
          return cloneElement(child, { name });
        }
        return child;
      })}
    &lt;/div&gt;
  );
}

// Usage:
// Even though we did not add the 'name' prop to each &lt;input /&gt;,
// RadioGroup will inject it into both clones.
function App() {
  return (
    &lt;RadioGroup name=3D&quot;theme-selection&quot;&gt;
      &lt;input type=3D&quot;radio&quot; value=3D&quot;light&quot; /&gt; Li=
ght
      &lt;input type=3D&quot;radio&quot; value=3D&quot;dark&quot; /&gt; Dar=
k
    &lt;/RadioGroup&gt;
  );
}" tabindex=3D"0" role=3D"button">
