n=3D"w" value=3D"/**
 * Pass additional data while redirecting
 */
import { BrowserRouter, Link, Route, Routes, useLocation } from &quot;react=
-router-dom&quot;;

/**
 * View User Component
 */
function ViewUser() {
  const location =3D useLocation();
  return (
    &lt;&gt;
      &lt;h2&gt;User Details&lt;/h2&gt;
      &lt;div&gt;Name:{location.state.name}&lt;/div&gt;
      &lt;div&gt;Email:{location.state.email}&lt;/div&gt;
    &lt;/&gt;
  );
}

/**
 * User Component
 */
function User() {
  return (
    &lt;div&gt;
      &lt;h2&gt;Pass additional data while redirecting&lt;/h2&gt;
      &lt;Link
        to=3D&quot;/view-user&quot;
        state=3D{{
          name: &quot;Kalini Khalsa&quot;,
          email: &quot;kalini.khalsa@email.com&quot;
        }}
      &gt;
        &lt;button&gt;View User&lt;/button&gt;
      &lt;/Link&gt;
    &lt;/div&gt;
  );
}

/**
 * App Component
 */
export default function App() {
  return (
    &lt;BrowserRouter&gt;
      &lt;Routes&gt;
        &lt;Route exact path=3D&quot;/&quot; element=3D{&lt;User /&gt;} /&g=
t;
        &lt;Route exact path=3D&quot;/user&quot; element=3D{&lt;User /&gt;}=
 /&gt;
        &lt;Route exact path=3D&quot;/view-user&quot; element=3D{&lt;ViewUs=
er /&gt;} /&gt;
      &lt;/Routes&gt;
    &lt;/BrowserRouter&gt;
  );
}" tabindex=3D"0" role=3D"button">
