    ...style,=20
    display: 'flex',=20
    alignItems: 'center',=20
    borderBottom: '1px solid #eee'=20
  }}&gt;
    Item {index}
  &lt;/div&gt;
);

const App =3D () =3D&gt; {
  return (
    // 2. Wrap the Row in a List component
    &lt;List
      height=3D{400}        // Visible height of the &quot;window&quot;
      width=3D{300}         // Width of the list
      itemCount=3D{10000}   // Total number of items in the dataset
      itemSize=3D{50}       // Height of each individual row in pixels
    &gt;
      {Row}
    &lt;/List&gt;
  );
};

