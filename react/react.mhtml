const express =3D require('express')
const puppeteer =3D require('puppeteer')
const app =3D express()

app.get('*', async (req, res) =3D&gt; {
  const isBot =3D /bot|googlebot|crawler|spider|robot|crawling/i.test(
    req.headers['user-agent']
  )
 =20
  if (isBot) {
    // Serve pre-rendered content to bots
    const browser =3D await puppeteer.launch()
    const page =3D await browser.newPage()
    await page.goto(`http://localhost:3000${req.url}`)
    const html =3D await page.content()
    await browser.close()
    res.send(html)
  } else {
    // Serve SPA to regular users
    res.sendFile('index.html')
  }
})" tabindex=3D"0" role=3D"button">
