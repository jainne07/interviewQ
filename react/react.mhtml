n=3D"w" value=3D"import { useState } from &quot;react&quot;;

export default function FileUpload() {
  const [file, setFile] =3D useState(null);
  const [preview, setPreview] =3D useState(null);
  const [status, setStatus] =3D useState(&quot;&quot;);

  const handleFileChange =3D (e) =3D&gt; {
    const selected =3D e.target.files[0];
    if (!selected) return;
    setFile(selected);
    // Show image preview
    if (selected.type.startsWith(&quot;image/&quot;)) {
      setPreview(URL.createObjectURL(selected));
    }
  };

  const handleUpload =3D async (e) =3D&gt; {
    e.preventDefault();
    if (!file) return;

    const formData =3D new FormData();
    formData.append(&quot;file&quot;, file);

    try {
      setStatus(&quot;Uploading...&quot;);
      const response =3D await fetch(&quot;/api/upload&quot;, {
        method: &quot;POST&quot;,
        body: formData, // Do NOT set Content-Type header manually
      });
      if (!response.ok) throw new Error(&quot;Upload failed&quot;);
      setStatus(&quot;Upload successful!&quot;);
    } catch (err) {
      setStatus(`Error: ${err.message}`);
    }
  };

  return (
    &lt;form onSubmit=3D{handleUpload}&gt;
      &lt;input type=3D&quot;file&quot; accept=3D&quot;image/*&quot; onChan=
ge=3D{handleFileChange} /&gt;
      {preview &amp;&amp; &lt;img src=3D{preview} alt=3D&quot;Preview&quot;=
 width=3D{200} /&gt;}
      &lt;button type=3D&quot;submit&quot; disabled=3D{!file}&gt;Upload&lt;=
/button&gt;
      &lt;p&gt;{status}&lt;/p&gt;
    &lt;/form&gt;
  );
}" tabindex=3D"0" role=3D"button">
