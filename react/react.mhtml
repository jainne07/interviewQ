import React, { createRef } from &quot;react&quot;;

type AppProps =3D Record&lt;string, never&gt;;
type AppState =3D { count: number };

export default class App extends React.Component&lt;AppProps, AppState&gt; =
{
  ref =3D createRef&lt;number&gt;();

  constructor(props: AppProps) {
    super(props);
    this.state =3D { count: 0 };
  }

  componentDidMount() {
    this.ref.current =3D 100; // Initial Value
  }

  componentDidUpdate(prevProps: AppProps, prevState: AppState) {
    if (prevState.count !=3D=3D this.state.count) {
      console.log(this.state.count, this.ref.current);
    }
  }

  render() {
    return (
      &lt;div className=3D&quot;App&quot;&gt;
        &lt;button onClick=3D{() =3D&gt; this.setState((s) =3D&gt; ({ count=
: s.count + 10 }))}&gt;
          Increment
        &lt;/button&gt;
        &lt;p&gt;{this.state.count}&lt;/p&gt;
      &lt;/div&gt;
    );
  }
}" tabindex=3D"0" role=3D"button">
