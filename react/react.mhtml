import { yupResolver } from &quot;@hookform/resolvers/yup&quot;;
import * as yup from &quot;yup&quot;;

const schema =3D yup.object({
  email: yup.string().email(&quot;Invalid email&quot;).required(&quot;Email=
 is required&quot;),
  password: yup.string().min(6, &quot;Min 6 characters&quot;).required(),
});

export default function LoginForm() {
  const { register, handleSubmit, formState: { errors } } =3D useForm({
    resolver: yupResolver(schema),
  });

  const onSubmit =3D (data) =3D&gt; console.log(data);

  return (
    &lt;form onSubmit=3D{handleSubmit(onSubmit)}&gt;
      &lt;input {...register(&quot;email&quot;)} placeholder=3D&quot;Email&=
quot; /&gt;
      {errors.email &amp;&amp; &lt;p&gt;{errors.email.message}&lt;/p&gt;}

      &lt;input {...register(&quot;password&quot;)} type=3D&quot;password&q=
uot; placeholder=3D&quot;Password&quot; /&gt;
      {errors.password &amp;&amp; &lt;p&gt;{errors.password.message}&lt;/p&=
gt;}

      &lt;button type=3D&quot;submit&quot;&gt;Login&lt;/button&gt;
    &lt;/form&gt;
  );
}" tabindex=3D"0" role=3D"button">
