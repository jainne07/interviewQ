n=3D"w" value=3D"/**
 * GET Request using Axios
 */
import { useEffect, useState } from &quot;react&quot;;
import axios from &quot;axios&quot;;

interface User {
  id: number;
  name: string;
  email: string;
}

export default function App() {
  const [users, setUsers] =3D useState&lt;User[]&gt;([]);
  const [loading, setLoading] =3D useState(true);
  const [error, setError] =3D useState(&quot;&quot;);

  useEffect(() =3D&gt; {
    const fetchUsers =3D async () =3D&gt; {
      try {
        const response =3D await axios.get(&quot;https://jsonplaceholder.ty=
picode.com/users&quot;);
        setUsers(response.data);
      } catch (error) {
        setError(&quot;Failed to fetch users: &quot; + (error as Error).mes=
sage);
      } finally {
        setLoading(false);
      }
    };

    fetchUsers();
  }, []);

  if (loading) return &lt;p&gt;Loading...&lt;/p&gt;;
  if (error) return &lt;p&gt;{error}&lt;/p&gt;;

  return (
    &lt;div&gt;
      &lt;h2&gt;User List&lt;/h2&gt;
      &lt;ul&gt;
        {users.map((user) =3D&gt; (
          &lt;li key=3D{user.id}&gt;
            {user.name} - {user.email}
          &lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/div&gt;
  );
