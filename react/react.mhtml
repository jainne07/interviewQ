n=3D"w" value=3D"import { useState } from &quot;react&quot;;

export default function LoginForm() {
  const [form, setForm] =3D useState({ email: &quot;&quot;, password: &quot=
;&quot; });
  const [errors, setErrors] =3D useState({});

  const validate =3D () =3D&gt; {
    const newErrors =3D {};
    if (!form.email.includes(&quot;@&quot;)) {
      newErrors.email =3D &quot;Enter a valid email address.&quot;;
    }
    if (form.password.length &lt; 6) {
      newErrors.password =3D &quot;Password must be at least 6 characters.&=
quot;;
    }
    return newErrors;
  };

  const handleChange =3D (e) =3D&gt; {
    const { name, value } =3D e.target;
    setForm((prev) =3D&gt; ({ ...prev, [name]: value }));
    // Clear error as user types
    setErrors((prev) =3D&gt; ({ ...prev, [name]: &quot;&quot; }));
  };

  const handleSubmit =3D (e) =3D&gt; {
    e.preventDefault();
    const validationErrors =3D validate();
    if (Object.keys(validationErrors).length &gt; 0) {
      setErrors(validationErrors);
      return;
    }
    console.log(&quot;Form submitted:&quot;, form);
  };

  return (
    &lt;form onSubmit=3D{handleSubmit}&gt;
      &lt;div&gt;
        &lt;input
          type=3D&quot;text&quot;
          name=3D&quot;email&quot;
          placeholder=3D&quot;Email&quot;
          value=3D{form.email}
          onChange=3D{handleChange}
        /&gt;
        {errors.email &amp;&amp; &lt;p style=3D{{ color: &quot;red&quot; }}=
&gt;{errors.email}&lt;/p&gt;}
      &lt;/div&gt;
      &lt;div&gt;
        &lt;input
          type=3D&quot;password&quot;
          name=3D&quot;password&quot;
          placeholder=3D&quot;Password&quot;
          value=3D{form.password}
          onChange=3D{handleChange}
        /&gt;
        {errors.password &amp;&amp; &lt;p style=3D{{ color: &quot;red&quot;=
 }}&gt;{errors.password}&lt;/p&gt;}
      &lt;/div&gt;
      &lt;button type=3D&quot;submit&quot;&gt;Login&lt;/button&gt;
    &lt;/form&gt;
  );
}" tabindex=3D"0" role=3D"button">
