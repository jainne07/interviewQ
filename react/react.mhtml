n=3D"w" value=3D"import { useRef, useImperativeHandle, forwardRef } from 'r=
eact'

interface InputHandle {
  focus: () =3D&gt; void
  clear: () =3D&gt; void
}

/**
 * A custom input component that exposes `focus` and `clear` methods
 * to parent components via `useImperativeHandle`.
 */
const CustomInput =3D forwardRef&lt;InputHandle&gt;((_, ref) =3D&gt; {
  const inputRef =3D useRef&lt;HTMLInputElement&gt;(null)

  useImperativeHandle(ref, () =3D&gt; ({
    focus() {
      inputRef.current?.focus()
    },
    clear() {
      if (inputRef.current) inputRef.current.value =3D ''
    },
  }))

  return &lt;input ref=3D{inputRef} type=3D&quot;text&quot; placeholder=3D&=
quot;Type something...&quot; /&gt;
})

CustomInput.displayName =3D 'CustomInput'

/**
 * App component that uses a ref to imperatively call `focus` and `clear`
 * on the CustomInput child component.
