n=3D"w" value=3D"import { useRef, useLayoutEffect } from 'react'

/**
 * Demonstrates useLayoutEffect() to measure a DOM element\'s width
 * synchronously after the browser has performed layout, before paint.
 */
const App =3D () =3D&gt; {
  const boxRef =3D useRef&lt;HTMLDivElement&gt;(null)
  const labelRef =3D useRef&lt;HTMLSpanElement&gt;(null)

  useLayoutEffect(() =3D&gt; {
    const measure =3D () =3D&gt; {
      if (boxRef.current &amp;&amp; labelRef.current) {
        const width =3D boxRef.current.getBoundingClientRect().width
        labelRef.current.textContent =3D `Box width: ${Math.round(width)}px=
`
      }
    }

    measure()
    window.addEventListener('resize', measure)
    return () =3D&gt; window.removeEventListener('resize', measure)
  }, [])

  return (
    &lt;div&gt;
      &lt;div ref=3D{boxRef} style=3D{{ width: '50%', background: '#d1d5db'=
, padding: '1rem' }}&gt;
        Resize the window
      &lt;/div&gt;
      &lt;span ref=3D{labelRef} /&gt;
    &lt;/div&gt;
  )
}

export default App" tabindex=3D"0" role=3D"button">
