function MyForm() {
  const { register, handleSubmit, formState: { errors } } =3D useForm();

  return (
    &lt;form onSubmit=3D{handleSubmit(console.log)}&gt;
      &lt;input
        {...register('email', {
          required: 'Email is required',
          pattern: {
            value: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
            message: 'Invalid email address',
          },
          maxLength: { value: 100, message: 'Max 100 characters' },
        })}
      /&gt;
      {errors.email &amp;&amp; &lt;p&gt;{errors.email.message}&lt;/p&gt;}

      &lt;input
        type=3D&quot;number&quot;
        {...register('age', {
          required: true,
          min: { value: 18, message: 'Must be at least 18' },
          max: { value: 100, message: 'Must be at most 100' },
          validate: (value) =3D&gt; Number.isInteger(Number(value)) || 'Mus=
t be a whole number',
        })}
      /&gt;
      {errors.age &amp;&amp; &lt;p&gt;{errors.age.message}&lt;/p&gt;}

      &lt;button type=3D&quot;submit&quot;&gt;Submit&lt;/button&gt;
    &lt;/form&gt;
  );
}" tabindex=3D"0" role=3D"button">
