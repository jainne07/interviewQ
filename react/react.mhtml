n=3D"w" value=3D"import { createContext, useContext, useState, useCallback =
} from 'react';

const AuthContext =3D createContext(null);

export function AuthProvider({ children }) {
  const [user, setUser] =3D useState(null);

  const login =3D useCallback(async (email, password) =3D&gt; {
    const userData =3D await loginService(email, password);
    setUser(userData);
  }, []);

  const logout =3D useCallback(() =3D&gt; {
    logoutService();
    setUser(null);
  }, []);

  return (
    &lt;AuthContext.Provider value=3D{{ user, login, logout, isAuthenticate=
d: !!user }}&gt;
      {children}
    &lt;/AuthContext.Provider&gt;
  );
}

export const useAuth =3D () =3D&gt; useContext(AuthContext);" tabindex=3D"0=
