function AppWithNavigate() {
  return (
    &lt;BrowserRouter&gt;
      &lt;nav style=3D{{ display: &quot;flex&quot;, gap: &quot;1em&quot; }}=
&gt;
        &lt;NavLink to=3D&quot;/home&quot;&gt;Home&lt;/NavLink&gt;
        &lt;NavLink to=3D&quot;/about&quot;&gt;About&lt;/NavLink&gt;
        &lt;NavLink to=3D&quot;/help&quot;&gt;Help&lt;/NavLink&gt;
      &lt;/nav&gt;
      &lt;Routes&gt;
        {/* Visiting &quot;/&quot; automatically redirects to &quot;/home&q=
uot; */}
        &lt;Route index element=3D{&lt;Navigate replace to=3D&quot;/home&qu=
ot; /&gt;} /&gt;
        &lt;Route path=3D&quot;home&quot; element=3D{&lt;h1&gt;Home Page&lt=
;/h1&gt;} /&gt;
        &lt;Route path=3D&quot;about&quot; element=3D{&lt;h1&gt;About Page&=
lt;/h1&gt;} /&gt;
        &lt;Route path=3D&quot;help&quot; element=3D{&lt;h1&gt;Help Page&lt=
;/h1&gt;} /&gt;
      &lt;/Routes&gt;
    &lt;/BrowserRouter&gt;
  );
}
