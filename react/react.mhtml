// It returns an object with 2 values:
// { Provider, Consumer }
const NumberContext =3D createContext&lt;number&gt;(0);
const CONTEXT_VALUE =3D 100;

function Display() {
  const value =3D useContext(NumberContext);
  return &lt;h3&gt;Context Value: {value}&lt;/h3&gt;;
}

/**
