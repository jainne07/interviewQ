} from &quot;react&quot;;

type Product =3D { id: number; name: string; price: number };
type CartItem =3D Product &amp; { quantity: number };

type CartAction =3D
  | { type: &quot;ADD&quot;; product: Product }
  | { type: &quot;REMOVE&quot;; id: number }
  | { type: &quot;INCREMENT&quot;; id: number }
  | { type: &quot;DECREMENT&quot;; id: number };

function cartReducer(state: CartItem[], action: CartAction): CartItem[] {
  switch (action.type) {
    case &quot;ADD&quot;: {
      const existing =3D state.find((i) =3D&gt; i.id =3D=3D=3D action.produ=
ct.id);
      if (existing) return state.map((i) =3D&gt; i.id =3D=3D=3D action.prod=
uct.id ? { ...i, quantity: i.quantity + 1 } : i);
      return [...state, { ...action.product, quantity: 1 }];
    }
    case &quot;REMOVE&quot;: return state.filter((i) =3D&gt; i.id !=3D=3D a=
ction.id);
    case &quot;INCREMENT&quot;: return state.map((i) =3D&gt; i.id =3D=3D=3D=
 action.id ? { ...i, quantity: i.quantity + 1 } : i);
    case &quot;DECREMENT&quot;: return state.map((i) =3D&gt; i.id =3D=3D=3D=
 action.id ? { ...i, quantity: Math.max(1, i.quantity - 1) } : i);
    default: return state;
  }
}

const CartContext =3D createContext&lt;{ cart: CartItem[]; dispatch: React.=
Dispatch&lt;CartAction&gt; } | null&gt;(null);

function CartProvider({ children }: { children: ReactNode }) {
  const [cart, dispatch] =3D useReducer(cartReducer, []);
  return &lt;CartContext.Provider value=3D{{ cart, dispatch }}&gt;{children=
}&lt;/CartContext.Provider&gt;;
}

function useCart() {
  const ctx =3D useContext(CartContext);
  if (!ctx) throw new Error(&quot;useCart must be inside CartProvider&quot;=
);
  return ctx;
}

const PRODUCTS: Product[] =3D [
  { id: 1, name: &quot;React T-Shirt&quot;, price: 29 },
  { id: 2, name: &quot;Next.js Mug&quot;, price: 15 },
