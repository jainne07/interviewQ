    decrement: (state) =3D&gt; { state.value -=3D state.step; },
    reset: (state) =3D&gt; { state.value =3D 0; },
    setStep: (state, action: PayloadAction&lt;number&gt;) =3D&gt; { state.s=
tep =3D action.payload; },
