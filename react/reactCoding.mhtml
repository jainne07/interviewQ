// useAuth: manages authentication state. Returns current auth status and l=
ogin/logout actions.
function useAuth() {
  const [isAuthenticated, setIsAuthenticated] =3D useState(false);

  return { isAuthenticated, login: () =3D&gt; setIsAuthenticated(true), log=
out: () =3D&gt; setIsAuthenticated(false) };
}

// LoginPage: shown when the user is not authenticated. Calls onLogin when =
the user submits.
function LoginPage({ onLogin }: Readonly&lt;{ onLogin: () =3D&gt; void }&gt=
;) {
  return (
    &lt;div&gt;
      &lt;h2&gt;Login&lt;/h2&gt;
      &lt;button onClick=3D{onLogin}&gt;Log in&lt;/button&gt;
    &lt;/div&gt;
  );
}

// Dashboard: protected page shown only to authenticated users. Calls onLog=
out to sign out.
function Dashboard({ onLogout }: Readonly&lt;{ onLogout: () =3D&gt; void }&=
gt;) {
  return (
    &lt;div&gt;
      &lt;h2&gt;Dashboard (protected)&lt;/h2&gt;
      &lt;button onClick=3D{onLogout}&gt;Log out&lt;/button&gt;
    &lt;/div&gt;
  );
}

// App: renders LoginPage or Dashboard based on authentication state.
export default function App() {
  const { isAuthenticated, login, logout } =3D useAuth();

  if (!isAuthenticated) {
    return &lt;LoginPage onLogin=3D{login} /&gt;;
  }

  return &lt;Dashboard onLogout=3D{logout} /&gt;;
