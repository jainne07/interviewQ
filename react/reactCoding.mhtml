// useDebounce =E2=80=94 returns a debounced copy of a value
function useDebounce&lt;T&gt;(value: T, delay: number): T {
  const [debounced, setDebounced] =3D useState(value);
  useEffect(() =3D&gt; {
    const id =3D setTimeout(() =3D&gt; setDebounced(value), delay);
    return () =3D&gt; clearTimeout(id);
  }, [value, delay]);
  return debounced;
}

// useThrottle =E2=80=94 limits how often a callback can fire
function useThrottle&lt;T extends unknown[]&gt;(fn: (...args: T) =3D&gt; vo=
id, delay: number) {
  const lastCall =3D useRef(0);
  return useCallback((...args: T) =3D&gt; {
    const now =3D Date.now();
    if (now - lastCall.current &gt;=3D delay) {
      lastCall.current =3D now;
      fn(...args);
    }
  }, [fn, delay]);
}

