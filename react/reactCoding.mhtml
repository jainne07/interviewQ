n=3D"w" value=3D"import { useState } from &quot;react&quot;;

type FormValues =3D { name: string; email: string; password: string };
type FormErrors =3D Partial&lt;Record&lt;keyof FormValues, string&gt;&gt;;

function validate(values: FormValues): FormErrors {
  const errors: FormErrors =3D {};
  if (!values.name.trim())            errors.name     =3D &quot;Name is req=
uired.&quot;;
  if (!values.email.includes(&quot;@&quot;))    errors.email    =3D &quot;E=
nter a valid email.&quot;;
  if (values.password.length &lt; 8)     errors.password =3D &quot;Password=
 must be at least 8 characters.&quot;;
  return errors;
}

export default function SignupForm() {
  const [values, setValues]     =3D useState&lt;FormValues&gt;({ name: &quo=
t;&quot;, email: &quot;&quot;, password: &quot;&quot; });
  const [errors, setErrors]     =3D useState&lt;FormErrors&gt;({});
  const [submitted, setSubmitted] =3D useState(false);

  const handleChange =3D (e: React.ChangeEvent&lt;HTMLInputElement&gt;) =3D=
&gt; {
    const { name, value } =3D e.target;
    setValues((prev) =3D&gt; ({ ...prev, [name]: value }));
    setErrors((prev)  =3D&gt; ({ ...prev, [name]: undefined }));
  };

  const handleSubmit =3D (e: React.FormEvent) =3D&gt; {
    e.preventDefault();
    const errs =3D validate(values);
    if (Object.keys(errs).length &gt; 0) { setErrors(errs); return; }
    setSubmitted(true);
  };

  if (submitted) return &lt;p&gt;Form submitted successfully!&lt;/p&gt;;

  return (
    &lt;form onSubmit=3D{handleSubmit} noValidate style=3D{{ display: &quot=
;flex&quot;, flexDirection: &quot;column&quot;, gap: 12, maxWidth: 360 }}&g=
t;
      &lt;h2&gt;Sign Up&lt;/h2&gt;
      {([&quot;name&quot;, &quot;email&quot;, &quot;password&quot;] as cons=
t).map((field) =3D&gt; (
        &lt;div key=3D{field}&gt;
          &lt;label&gt;
            {field.charAt(0).toUpperCase() + field.slice(1)}
            &lt;input
              type=3D{field =3D=3D=3D &quot;password&quot; ? &quot;password=
&quot; : field =3D=3D=3D &quot;email&quot; ? &quot;email&quot; : &quot;text=
&quot;}
              name=3D{field}
              value=3D{values[field]}
              onChange=3D{handleChange}
              style=3D{{ display: &quot;block&quot;, width: &quot;100%&quot=
;, marginTop: 4 }}
            /&gt;
          &lt;/label&gt;
          {errors[field] &amp;&amp; &lt;p style=3D{{ color: &quot;red&quot;=
, margin: &quot;4px 0 0&quot; }}&gt;{errors[field]}&lt;/p&gt;}
        &lt;/div&gt;
      ))}
      &lt;button type=3D&quot;submit&quot;&gt;Submit&lt;/button&gt;
    &lt;/form&gt;
  );
}" tabindex=3D"0" role=3D"button">
