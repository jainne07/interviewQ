    case &quot;success&quot;: return { data: action.payload, loading: false=
, error: null };
    case &quot;error&quot;:   return { data: null, loading: false, error: a=
ction.payload };
  }
}

function useFetch&lt;T&gt;(url: string) {
  const [state, dispatch] =3D useReducer(fetchReducer&lt;T&gt;, {
