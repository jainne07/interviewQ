n=3D"w" value=3D"import { useRef } from &quot;react&quot;;
import axios from &quot;axios&quot;;

const UPLOAD_URL =3D &quot;FILE_DIRECTORY&quot;;

async function uploadImage(file: File) {
  const formData =3D new FormData();
  formData.append(&quot;filename&quot;, file);
  formData.append(&quot;destination&quot;, &quot;images&quot;);
  formData.append(&quot;create_thumbnail&quot;, &quot;true&quot;);

  await axios.post(UPLOAD_URL, formData, {
    headers: { &quot;content-type&quot;: &quot;multipart/form-data&quot; },
  });
}

export default function App() {
  const fileRef =3D useRef&lt;File | null&gt;(null);

  async function handleUpload() {
    if (!fileRef.current) return;
    try {
      await uploadImage(fileRef.current);
    } catch (error) {
      console.error(&quot;Upload failed:&quot;, error);
    }
  }

  return (
    &lt;div className=3D&quot;App&quot;&gt;
      &lt;h1&gt;File Upload in React&lt;/h1&gt;
      &lt;input
        type=3D&quot;file&quot;
        name=3D&quot;file&quot;
        onChange=3D{(e) =3D&gt; {
          fileRef.current =3D e.target.files?.[0] ?? null;
        }}
      /&gt;
      &lt;button onClick=3D{handleUpload}&gt;Upload&lt;/button&gt;
    &lt;/div&gt;
  );
}" tabindex=3D"0" role=3D"button">
