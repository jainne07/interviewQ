const cartSlice =3D createSlice({
  name: &quot;cart&quot;,
  initialState: [] as CartItem[],
  reducers: {
    addItem: (state, action: PayloadAction&lt;Omit&lt;CartItem, &quot;quant=
ity&quot;&gt;&gt;) =3D&gt; {
      const existing =3D state.find((i) =3D&gt; i.id =3D=3D=3D action.paylo=
ad.id);
      if (existing) { existing.quantity +=3D 1; }
      else { state.push({ ...action.payload, quantity: 1 }); }
    },
    removeItem: (state, action: PayloadAction&lt;number&gt;) =3D&gt;
      state.filter((i) =3D&gt; i.id !=3D=3D action.payload),
    updateQuantity: (state, action: PayloadAction&lt;{ id: number; quantity=
: number }&gt;) =3D&gt; {
      const item =3D state.find((i) =3D&gt; i.id =3D=3D=3D action.payload.i=
d);
      if (item) item.quantity =3D Math.max(1, action.payload.quantity);
    },
    clearCart: () =3D&gt; [],
  },
});

export const { addItem, removeItem, updateQuantity, clearCart } =3D cartSli=
