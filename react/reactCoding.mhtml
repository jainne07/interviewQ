n=3D"w" value=3D"import { useMemo, useState } from &quot;react&quot;;

export default function App() {
  const [searchItem, setSearchItem] =3D useState(&quot;&quot;);

  const searchResults =3D useMemo(
    () =3D&gt;
      people.filter((person) =3D&gt;
        person.toLowerCase().includes(searchItem.toLowerCase()),
      ),
    [searchItem],
  );

  return (
    &lt;div className=3D&quot;App&quot;&gt;
      &lt;input
        type=3D&quot;text&quot;
        placeholder=3D&quot;Search&quot;
        value=3D{searchItem}
        onChange=3D{(e) =3D&gt; setSearchItem(e.target.value)}
      /&gt;
      &lt;ul&gt;
        {searchResults.map((item) =3D&gt; (
          &lt;li key=3D{item}&gt;{item}&lt;/li&gt;
        ))}
      &lt;/ul&gt;
    &lt;/div&gt;
  );
}" tabindex=3D"0" role=3D"button">
