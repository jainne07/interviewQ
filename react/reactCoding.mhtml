  _prevState: FormState,
  formData: FormData
): Promise&lt;FormState&gt; {
  const name =3D formData.get(&quot;name&quot;) as string;
  const email =3D formData.get(&quot;email&quot;) as string;
  const message =3D formData.get(&quot;message&quot;) as string;

