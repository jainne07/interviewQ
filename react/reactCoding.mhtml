import { createSlice, createAsyncThunk } from &quot;@reduxjs/toolkit&quot;;

type Post =3D { id: number; title: string; body: string };
type PostsState =3D { data: Post[]; loading: boolean; error: string | null =
};

export const fetchPosts =3D createAsyncThunk&lt;Post[], void, { rejectValue=
: string }&gt;(
  &quot;posts/fetchAll&quot;,
  async (_, { rejectWithValue }) =3D&gt; {
    const res =3D await fetch(&quot;https://jsonplaceholder.typicode.com/po=
sts?_limit=3D10&quot;);
    if (!res.ok) return rejectWithValue(`HTTP error ${res.status}`);
    return res.json() as Promise&lt;Post[]&gt;;
  }
);

const postsSlice =3D createSlice({
