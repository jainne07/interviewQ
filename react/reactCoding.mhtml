  // Solution 2: Depend on a primitive value instead of an object
  const [count2, setCount2] =3D useState(0);
  const [trigger, setTrigger] =3D useState(0);
  useEffect(() =3D&gt; {
    setCount2(prev =3D&gt; prev + 1);
