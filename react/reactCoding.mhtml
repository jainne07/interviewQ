          &gt;
            {p}
          &lt;/button&gt;
        ))}
        &lt;button disabled=3D{page =3D=3D=3D totalPages} onClick=3D{() =3D=
&gt; setPage((p) =3D&gt; p + 1)}&gt;Next&lt;/button&gt;
      &lt;/div&gt;
      &lt;p&gt;Page {page} of {totalPages}&lt;/p&gt;
    &lt;/&gt;
  );
