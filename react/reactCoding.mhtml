import { createSlice, PayloadAction, createAsyncThunk } from &quot;@reduxjs=
/toolkit&quot;;

export type Todo =3D { id: number; title: string; completed: boolean };
type TodosState =3D { items: Todo[]; loading: boolean; filter: &quot;all&qu=
ot; | &quot;active&quot; | &quot;completed&quot; };

// Seed data from API on first load
export const loadTodos =3D createAsyncThunk(&quot;todos/load&quot;, async (=
) =3D&gt; {
  const res =3D await fetch(&quot;https://jsonplaceholder.typicode.com/todo=
s?_limit=3D8&quot;);
  if (!res.ok) throw new Error(&quot;Failed to load todos&quot;);
  return res.json() as Promise&lt;Todo[]&gt;;
});

const todosSlice =3D createSlice({
  name: &quot;todos&quot;,
  initialState: { items: [], loading: false, filter: &quot;all&quot; } as T=
odosState,
  reducers: {
    addTodo: (state, action: PayloadAction&lt;string&gt;) =3D&gt; {
      state.items.unshift({ id: Date.now(), title: action.payload, complete=
d: false });
    },
    toggleTodo: (state, action: PayloadAction&lt;number&gt;) =3D&gt; {
      const todo =3D state.items.find((t) =3D&gt; t.id =3D=3D=3D action.pay=
load);
      if (todo) todo.completed =3D !todo.completed;
    },
    deleteTodo: (state, action: PayloadAction&lt;number&gt;) =3D&gt; {
      state.items =3D state.items.filter((t) =3D&gt; t.id !=3D=3D action.pa=
yload);
    },
    editTodo: (state, action: PayloadAction&lt;{ id: number; title: string =
}&gt;) =3D&gt; {
      const todo =3D state.items.find((t) =3D&gt; t.id =3D=3D=3D action.pay=
load.id);
      if (todo) todo.title =3D action.payload.title;
    },
    clearCompleted: (state) =3D&gt; { state.items =3D state.items.filter((t=
) =3D&gt; !t.completed); },
    setFilter: (state, action: PayloadAction&lt;TodosState[&quot;filter&quo=
t;]&gt;) =3D&gt; { state.filter =3D action.payload; },
  },
  extraReducers: (builder) =3D&gt; {
    builder
      .addCase(loadTodos.pending, (state) =3D&gt; { state.loading =3D true;=
 })
      .addCase(loadTodos.fulfilled, (state, action) =3D&gt; { state.loading=
 =3D false; state.items =3D action.payload; })
      .addCase(loadTodos.rejected, (state) =3D&gt; { state.loading =3D fals=
e; });
  },
});

export const { addTodo, toggleTodo, deleteTodo, editTodo, clearCompleted, s=
etFilter } =3D todosSlice.actions;
