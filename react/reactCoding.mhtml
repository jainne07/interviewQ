  // Solution 3: Use useRef for mutable data that shouldn\'t trigger re-ren=
ders
  const [count3, setCount3] =3D useState(0);
  const dataRef =3D useRef({ value: 0 });
  useEffect(() =3D&gt; {
    setCount3(prev =3D&gt; prev + 1);
    dataRef.current =3D { value: count3 };
  }, []); // Refs don\'t trigger re-renders

  return (
    &lt;div style=3D{{ padding: '20px' }}&gt;
      &lt;p&gt;Solution 1 (empty deps): {count1}&lt;/p&gt;
      &lt;p&gt;Solution 2 (primitive dep): {count2}&lt;/p&gt;
      &lt;button onClick=3D{() =3D&gt; setTrigger(t =3D&gt; t + 1)}&gt;Trig=
ger Effect&lt;/button&gt;
      &lt;p&gt;Solution 3 (useRef): {count3}&lt;/p&gt;
    &lt;/div&gt;
  );
