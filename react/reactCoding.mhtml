import { useCookies } from &quot;react-cookie&quot;;

const App =3D () =3D&gt; {
  const [name, setName] =3D useState(&quot;&quot;);
  const [cookies, setCookie] =3D useCookies([&quot;name&quot;]);

  const handle =3D () =3D&gt; {
    setCookie(&quot;name&quot;, name, { path: &quot;/&quot; });
  };

  return (
    &lt;&gt;
      &lt;h1&gt;Cookies in React&lt;/h1&gt;
      &lt;input
        placeholder=3D&quot;Cookie value&quot;
        value=3D{name}
        onChange=3D{(e) =3D&gt; setName(e.target.value)}
      /&gt;
      &lt;button onClick=3D{handle}&gt;Set Cookie&lt;/button&gt;
      {cookies.name &amp;&amp; &lt;div&gt;Cookies Value: {cookies.name}&lt;=
/div&gt;}
    &lt;/&gt;
  );
};

export default App;" tabindex=3D"0" role=3D"button">
