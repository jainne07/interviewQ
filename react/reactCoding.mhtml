n=3D"w" value=3D"import axios from &quot;axios&quot;;
import { useEffect, useState } from &quot;react&quot;;

const API_URL =3D &quot;https://jsonplaceholder.typicode.com/users&quot;;

export default function Page() {
  const [data, setData] =3D useState(null);
  const [error, setError] =3D useState&lt;string | null&gt;(null);

  useEffect(() =3D&gt; {
    const fetchData =3D async () =3D&gt; {
      const raw =3D sessionStorage.getItem(&quot;data&quot;);
      if (!raw) throw new Error(&quot;No session data found.&quot;);

      const token: string =3D JSON.parse(raw).data.id;
      const res =3D await axios.get(API_URL, {
        headers: { Authorization: `Bearer ${token}` }, // Authorization tok=
en in axios
      });
      setData(res.data);
    };

    fetchData().catch((err: Error) =3D&gt; setError(err.message));
  }, []);

  if (error) return &lt;p&gt;Error: {error}&lt;/p&gt;;
  if (!data) return &lt;p&gt;Loading=E2=80=A6&lt;/p&gt;;

  return &lt;pre&gt;{JSON.stringify(data, null, 2)}&lt;/pre&gt;;
}" tabindex=3D"0" role=3D"button">
