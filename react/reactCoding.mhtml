import { NextRequest, NextResponse } from &quot;next/server&quot;;

const PROTECTED_ROUTES =3D [&quot;/dashboard&quot;, &quot;/profile&quot;, &=
quot;/settings&quot;];
const PUBLIC_ROUTES =3D [&quot;/login&quot;, &quot;/register&quot;];

export function middleware(req: NextRequest) {
  const { pathname } =3D req.nextUrl;
  const token =3D req.cookies.get(&quot;auth-token&quot;)?.value;

  const isProtected =3D PROTECTED_ROUTES.some((r) =3D&gt; pathname.startsWi=
th(r));
  const isPublic =3D PUBLIC_ROUTES.some((r) =3D&gt; pathname.startsWith(r))=
;

  // Redirect unauthenticated users away from protected routes
  if (isProtected &amp;&amp; !token) {
    const loginUrl =3D new URL(&quot;/login&quot;, req.url);
    loginUrl.searchParams.set(&quot;callbackUrl&quot;, pathname);
    return NextResponse.redirect(loginUrl);
  }

  // Redirect authenticated users away from login/register
  if (isPublic &amp;&amp; token) {
    return NextResponse.redirect(new URL(&quot;/dashboard&quot;, req.url));
  }

  return NextResponse.next();
}

