&quot;, id: item.id })}&gt;+&lt;/button&gt;
          &lt;button onClick=3D{() =3D&gt; dispatch({ type: &quot;REMOVE&qu=
ot;, id: item.id })}&gt;=E2=9C=95&lt;/button&gt;
        &lt;/div&gt;
