        style=3D{{
          width: &quot;100%&quot;, display: &quot;flex&quot;, justifyConten=
t: &quot;space-between&quot;, alignItems: &quot;center&quot;,
          padding: &quot;12px 16px&quot;, background: isOpen ? &quot;#eff6f=
f&quot; : &quot;#f9fafb&quot;,
          border: &quot;none&quot;, cursor: &quot;pointer&quot;, fontWeight=
: 600, textAlign: &quot;left&quot;,
        }}
      &gt;
        {item.title}
        &lt;span style=3D{{ fontSize: 18, transform: isOpen ? &quot;rotate(=
180deg)&quot; : &quot;none&quot;, transition: &quot;transform 0.2s&quot; }}=
&gt;=E2=96=BE&lt;/span&gt;
      &lt;/button&gt;
      {isOpen &amp;&amp; (
        &lt;div style=3D{{ padding: &quot;12px 16px&quot;, background: &quo=
t;#fff&quot; }}&gt;
          {item.content}
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
}

type AccordionProps =3D Readonly&lt;{ items: AccordionItem[]; allowMultiple=
?: boolean }&gt;;

export function Accordion({ items, allowMultiple =3D false }: AccordionProp=
s) {
  const [openIndexes, setOpenIndexes] =3D useState&lt;Set&lt;number&gt;&gt;=
(new Set());

  const toggle =3D (index: number) =3D&gt; {
    setOpenIndexes((prev) =3D&gt; {
      const next =3D new Set(allowMultiple ? prev : new Set&lt;number&gt;()=
);
      if (prev.has(index)) next.delete(index);
      else next.add(index);
      return next;
    });
  };

  return (
    &lt;div&gt;
      {items.map((item, i) =3D&gt; (
        &lt;AccordionPanel key=3D{item.title} item=3D{item} isOpen=3D{openI=
ndexes.has(i)} onToggle=3D{() =3D&gt; toggle(i)} /&gt;
      ))}
    &lt;/div&gt;
  );
}

