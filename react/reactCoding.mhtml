 1))}&gt;-&lt;/button&gt;
      &lt;button onClick=3D{() =3D&gt; setCount((c) =3D&gt; c + 1)}&gt;+&lt=
;/button&gt;
    &lt;/div&gt;
  );
}" tabindex=3D"0" role=3D"button">
