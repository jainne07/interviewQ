const TOTAL_ITEMS =3D 100;
const PAGE_SIZE   =3D 10;

function usePagination(total: number, pageSize: number) {
  const [page, setPage] =3D useState(1);
  const totalPages =3D Math.ceil(total / pageSize);

  const items =3D useMemo(() =3D&gt; {
    const start =3D (page - 1) * pageSize + 1;
    const end   =3D Math.min(page * pageSize, total);
    return Array.from({ length: end - start + 1 }, (_, i) =3D&gt; start + i=
);
  }, [page, pageSize, total]);

  return { page, totalPages, items, setPage };
}

export default function App() {
  const { page, totalPages, items, setPage } =3D usePagination(TOTAL_ITEMS,=
 PAGE_SIZE);

  return (
    &lt;&gt;
      &lt;h2&gt;Pagination&lt;/h2&gt;
      &lt;ul&gt;
        {items.map((n) =3D&gt; &lt;li key=3D{n}&gt;Item {n}&lt;/li&gt;)}
      &lt;/ul&gt;
      &lt;div style=3D{{ display: &quot;flex&quot;, gap: 8, marginTop: 12 }=
}&gt;
        &lt;button disabled=3D{page =3D=3D=3D 1} onClick=3D{() =3D&gt; setP=
age((p) =3D&gt; p - 1)}&gt;Prev&lt;/button&gt;
        {Array.from({ length: totalPages }, (_, i) =3D&gt; i + 1).map((p) =
=3D&gt; (
          &lt;button
            key=3D{p}
            onClick=3D{() =3D&gt; setPage(p)}
            style=3D{{ fontWeight: p =3D=3D=3D page ? &quot;bold&quot; : &q=
