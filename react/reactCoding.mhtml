t;] },
  { name: &quot;Tamil Nadu&quot;, cities: [&quot;Chennai&quot;, &quot;Coimb=
atore&quot;, &quot;Madurai&quot;, &quot;Tiruchirappalli&quot;] },
];

export default function App() {
  const [capital, setCapital] =3D useState(&quot;&quot;);
  const [cities, setCities] =3D useState&lt;string[]&gt;([]);
  const [city, setCity] =3D useState(&quot;&quot;);

  function updateSelect(e: React.ChangeEvent&lt;HTMLSelectElement&gt;) {
    const selected =3D e.target.value;
    setCapital(selected);
    setCities(data.find((d) =3D&gt; d.name =3D=3D=3D selected)?.cities ?? [=
]);
    setCity(&quot;&quot;);
  }

  return (
    &lt;&gt;
      &lt;select value=3D{capital} onChange=3D{updateSelect}&gt;
        &lt;option value=3D&quot;&quot; disabled&gt;--- SELECT ---&lt;/opti=
on&gt;
        {data.map((d) =3D&gt; (
          &lt;option key=3D{d.name} value=3D{d.name}&gt;{d.name}&lt;/option=
&gt;
        ))}
      &lt;/select&gt;
      &lt;select value=3D{city} onChange=3D{(e) =3D&gt; setCity(e.target.va=
lue)}&gt;
        &lt;option value=3D&quot;&quot; disabled&gt;--- SELECT ---&lt;/opti=
on&gt;
        {cities.map((city) =3D&gt; (
          &lt;option key=3D{city} value=3D{city}&gt;{city}&lt;/option&gt;
