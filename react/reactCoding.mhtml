)&lt;/h3&gt;
      {cart.length =3D=3D=3D 0 ? &lt;p&gt;Empty cart&lt;/p&gt; : cart.map((=
item) =3D&gt; (
        &lt;div key=3D{item.id} style=3D{{ display: &quot;flex&quot;, gap: =
8, marginBottom: 8, alignItems: &quot;center&quot; }}&gt;
          &lt;span style=3D{{ flex: 1 }}&gt;{item.name}&lt;/span&gt;
