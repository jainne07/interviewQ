n=3D"w" value=3D"import { useCallback, useState } from &quot;react&quot;;

interface Todo {
  id: number;
  text: string;
  completed: boolean;
}

export default function App() {
  const [todos, setTodos] =3D useState&lt;Todo[]&gt;([]);
  const [input, setInput] =3D useState(&quot;&quot;);

  const addTodo =3D useCallback(() =3D&gt; {
    const trimmed =3D input.trim();
    if (!trimmed) return;
    setTodos((prev) =3D&gt; [
      ...prev,
      { id: Date.now(), text: trimmed, completed: false },
    ]);
    setInput(&quot;&quot;);
  }, [input]);

  const toggleTodo =3D useCallback((id: number) =3D&gt; {
    setTodos((prev) =3D&gt;
      prev.map((todo) =3D&gt;
        todo.id =3D=3D=3D id ? { ...todo, completed: !todo.completed } : to=
do,
      ),
    );
  }, []);

  const deleteTodo =3D useCallback((id: number) =3D&gt; {
    setTodos((prev) =3D&gt; prev.filter((todo) =3D&gt; todo.id !=3D=3D id))=
;
  }, []);

  const handleKeyDown =3D useCallback(
    (e: React.KeyboardEvent&lt;HTMLInputElement&gt;) =3D&gt; {
      if (e.key =3D=3D=3D &quot;Enter&quot;) addTodo();
    },
    [addTodo],
  );

  return (
    &lt;div&gt;
      &lt;h1&gt;ToDo List&lt;/h1&gt;

      &lt;div&gt;
        &lt;input
          type=3D&quot;text&quot;
          value=3D{input}
          onChange=3D{(e) =3D&gt; setInput(e.target.value)}
          onKeyDown=3D{handleKeyDown}
          placeholder=3D&quot;Add a new task=E2=80=A6&quot;
        /&gt;
        &lt;button onClick=3D{addTodo}&gt;Add&lt;/button&gt;
      &lt;/div&gt;

      {todos.length =3D=3D=3D 0 ? (
        &lt;p&gt;No tasks yet. Add one above!&lt;/p&gt;
      ) : (
        &lt;ul&gt;
          {todos.map((todo) =3D&gt; (
            &lt;li key=3D{todo.id}&gt;
              &lt;input
                type=3D&quot;checkbox&quot;
                checked=3D{todo.completed}
                onChange=3D{() =3D&gt; toggleTodo(todo.id)}
              /&gt;
              &lt;span
                style=3D{{
                  flex: 1,
                  textDecoration: todo.completed ? &quot;line-through&quot;=
 : &quot;none&quot;,
                  color: todo.completed ? &quot;#aaa&quot; : &quot;inherit&=
quot;,
                }}
              &gt;
                {todo.text}
              &lt;/span&gt;
              &lt;button
                onClick=3D{() =3D&gt; deleteTodo(todo.id)}
                aria-label=3D&quot;Delete task&quot;
              &gt;
                X
              &lt;/button&gt;
            &lt;/li&gt;
          ))}
        &lt;/ul&gt;
      )}

      {todos.length &gt; 0 &amp;&amp; (
        &lt;p&gt;
          {todos.filter((t) =3D&gt; t.completed).length} / {todos.length} c=
ompleted
        &lt;/p&gt;
      )}
    &lt;/div&gt;
  );
