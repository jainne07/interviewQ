type AccordionItem =3D { title: string; content: ReactNode };

function AccordionPanel({ item, isOpen, onToggle }: { item: AccordionItem; =
isOpen: boolean; onToggle: () =3D&gt; void }) {
  return (
    &lt;div style=3D{{ border: &quot;1px solid #e5e7eb&quot;, borderRadius:=
 6, marginBottom: 8, overflow: &quot;hidden&quot; }}&gt;
      &lt;button
