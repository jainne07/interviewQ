    updatePost: build.mutation({
      query: ({ id, ...patch }) =3D&gt; ({
        url: `post/${id}`,
        method: 'PATCH',
        body: patch,
      }),
      // Optimistic update
      async onQueryStarted({ id, ...patch }, { dispatch, queryFulfilled }) =
{
        // Apply patch immediately
        const patchResult =3D dispatch(
          api.util.updateQueryData('getPosts', undefined, (draft) =3D&gt; {
            const post =3D draft.find((p) =3D&gt; p.id =3D=3D=3D id)
            if (post) Object.assign(post, patch)
          })
        )
        try {
          await queryFulfilled
        } catch {
          // Roll back on failure
          patchResult.undo()
        }
      },
      invalidatesTags: ['Post'],
    }),
  }),
})" tabindex=3D"0" role=3D"button">
