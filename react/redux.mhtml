n=3D"w" value=3D"import {
  useGetUserQuery,
  useUpdateUserMutation,
} from '../services/usersApi'

function UserProfile({ userId }) {
  const { data: user, isLoading } =3D useGetUserQuery(userId)
  const [updateUser, { isLoading: isUpdating }] =3D useUpdateUserMutation()

  if (isLoading) return &lt;p&gt;Loading...&lt;/p&gt;

  const handleUpdate =3D async () =3D&gt; {
    try {
      await updateUser({ id: userId, name: 'New Name' }).unwrap()
      console.log('Updated!')
    } catch (err) {
      console.error('Failed to update:', err)
    }
  }

  return (
    &lt;div&gt;
      &lt;h2&gt;{user.name}&lt;/h2&gt;
      &lt;button onClick=3D{handleUpdate} disabled=3D{isUpdating}&gt;
        {isUpdating ? 'Updating...' : 'Update Name'}
      &lt;/button&gt;
    &lt;/div&gt;
  )
}" tabindex=3D"0" role=3D"button">
