n=3D"w" value=3D"import { createApi, fetchBaseQuery } from '@reduxjs/toolki=
t/query/react'

export const postsApi =3D createApi({
  reducerPath: 'postsApi',
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  tagTypes: ['Post'],                // declare all tag types
  endpoints: (builder) =3D&gt; ({

    getPosts: builder.query({
      query: () =3D&gt; '/posts',
      providesTags: (result) =3D&gt;
        result
          ? [
              ...result.map(({ id }) =3D&gt; ({ type: 'Post', id })),
              { type: 'Post', id: 'LIST' },
            ]
          : [{ type: 'Post', id: 'LIST' }],
    }),

    getPostById: builder.query({
      query: (id) =3D&gt; `/posts/${id}`,
      providesTags: (result, error, id) =3D&gt; [{ type: 'Post', id }],
    }),

    addPost: builder.mutation({
      query: (body) =3D&gt; ({ url: '/posts', method: 'POST', body }),
      invalidatesTags: [{ type: 'Post', id: 'LIST' }],
    }),

    updatePost: builder.mutation({
      query: ({ id, ...patch }) =3D&gt; ({
        url: `/posts/${id}`,
        method: 'PUT',
        body: patch,
      }),
      invalidatesTags: (result, error, { id }) =3D&gt; [{ type: 'Post', id =
}],
    }),

    deletePost: builder.mutation({
      query: (id) =3D&gt; ({ url: `/posts/${id}`, method: 'DELETE' }),
      invalidatesTags: (result, error, id) =3D&gt; [{ type: 'Post', id }],
    }),
  }),
})

export const {
  useGetPostsQuery,
  useGetPostByIdQuery,
  useAddPostMutation,
  useUpdatePostMutation,
  useDeletePostMutation,
} =3D postsApi" tabindex=3D"0" role=3D"button">
