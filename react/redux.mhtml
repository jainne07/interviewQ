n=3D"w" value=3D"import { useLazyGetUserQuery } from '../services/usersApi'

function SearchUser() {
  const [trigger, result, lastPromiseInfo] =3D useLazyGetUserQuery()
  const [username, setUsername] =3D React.useState('')

  const handleSearch =3D () =3D&gt; {
    trigger(username) // manually fire the query
  }

  return (
    &lt;div&gt;
      &lt;input
        value=3D{username}
        onChange=3D{(e) =3D&gt; setUsername(e.target.value)}
        placeholder=3D&quot;Enter username&quot;
      /&gt;
      &lt;button onClick=3D{handleSearch}&gt;Search&lt;/button&gt;

      {result.isLoading &amp;&amp; &lt;p&gt;Searching...&lt;/p&gt;}
      {result.isError &amp;&amp; &lt;p&gt;User not found.&lt;/p&gt;}
      {result.data &amp;&amp; &lt;p&gt;Name: {result.data.name}&lt;/p&gt;}
    &lt;/div&gt;
  )
}" tabindex=3D"0" role=3D"button">
