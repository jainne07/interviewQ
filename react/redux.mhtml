n=3D"w" value=3D"export const loginUser =3D createAsyncThunk(
  'auth/login',
  async (credentials, { rejectWithValue }) =3D&gt; {
    try {
      const response =3D await axios.post('/api/login', credentials);
      return response.data;
    } catch (err) {
      // Use `rejectWithValue` to return a custom error payload
      return rejectWithValue(err.response.data);
    }
  }
);

const authSlice =3D createSlice({
  name: 'auth',
  initialState: {
    user: null,
    token: null,
    loading: false,
    error: null
  },
  reducers: {
    logout: (state) =3D&gt; {
      state.user =3D null;
      state.token =3D null;
    }
  },
  extraReducers: (builder) =3D&gt; {
    builder
      .addCase(loginUser.pending, (state) =3D&gt; {
        state.loading =3D true;
        state.error =3D null;
      })
      .addCase(loginUser.fulfilled, (state, action) =3D&gt; {
        state.loading =3D false;
        state.user =3D action.payload.user;
        state.token =3D action.payload.token;
      })
      .addCase(loginUser.rejected, (state, action) =3D&gt; {
        state.loading =3D false;
        state.error =3D action.payload || action.error.message;
      });
  }
});" tabindex=3D"0" role=3D"button">
