import { createStore, combineReducers, applyMiddleware } from 'redux'; // =
=E2=9A=A0=EF=B8=8F createStore deprecated
import { thunk } from 'redux-thunk'; // Named import required since redux-t=
hunk v3
import { composeWithDevTools } from 'redux-devtools-extension'; // =E2=9A=
=A0=EF=B8=8F use Redux DevTools built into configureStore instead

const ADD_TODO =3D 'ADD_TODO';
const TOGGLE_TODO =3D 'TOGGLE_TODO';

function addTodo(text) {
  return { type: ADD_TODO, payload: text };
}

function todosReducer(state =3D [], action) {
  switch (action.type) {
    case ADD_TODO:
      return [...state, { text: action.payload, completed: false }];
    case TOGGLE_TODO:
      return state.map((todo, index) =3D&gt;
        index =3D=3D=3D action.payload ? { ...todo, completed: !todo.comple=
ted } : todo
      );
    default:
      return state;
  }
}

const rootReducer =3D combineReducers({ todos: todosReducer });
const store =3D createStore(
  rootReducer,
  composeWithDevTools(applyMiddleware(thunk))
);

