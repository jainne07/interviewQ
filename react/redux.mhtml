import { useGetPostsQuery } from '../services/postsApi'

function PostsList() {
  const { data: posts, isLoading, isError, error } =3D useGetPostsQuery()

  if (isLoading) return &lt;p&gt;Loading...&lt;/p&gt;
  if (isError) return &lt;p&gt;Error: {error.message}&lt;/p&gt;

  return (
    &lt;ul&gt;
      {posts.map((post) =3D&gt; (
        &lt;li key=3D{post.id}&gt;{post.title}&lt;/li&gt;
      ))}
    &lt;/ul&gt;
  )
}

