n=3D"w" value=3D"const initialState =3D {
  contacts: [{
    name: 'Alex K',
    age: 26
  }]
}

const contactReducer =3D (state =3D initialState, action) =3D&gt; {
  switch (action.type) {
    case &quot;NEW_CONTACT&quot;:
      return Object.assign({}, state, {
        contacts: [...state.contacts, action.payload]
      });
    default:
      return state
  }
}

class App extends React.Component {
  constructor(props) {
    super(props)
    this.name =3D React.createRef()
    this.age =3D React.createRef()
    this.state =3D initialState
  }

  handleSubmit =3D e =3D&gt; {
    e.preventDefault()
    const action =3D {
      type: &quot;NEW_CONTACT&quot;,
      payload: {
        name: this.name.current.value,
        age: this.age.current.value
      }
    }
    const newState =3D contactReducer(this.state, action)
    this.setState(newState)
  }

  render() {
    const { contacts } =3D this.state
    return (
      &lt;div className=3D&quot;box&quot;&gt;
        &lt;div className=3D&quot;content&quot;&gt;
          &lt;pre&gt;{JSON.stringify(this.state, null, 2)}&lt;/pre&gt;
        &lt;/div&gt;

        &lt;div className=3D&quot;field&quot;&gt;
          &lt;form onSubmit=3D{this.handleSubmit}&gt;
            &lt;div className=3D&quot;control&quot;&gt;
              &lt;input className=3D&quot;input&quot; placeholder=3D&quot;F=
ull Name&quot; type=3D&quot;text&quot; ref=3D{this.name} /&gt;
            &lt;/div&gt;
            &lt;div className=3D&quot;control&quot;&gt;
              &lt;input className=3D&quot;input&quot; placeholder=3D&quot;A=
ge&quot; type=3D&quot;number&quot; ref=3D{this.age} /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;button type=3D&quot;submit&quot; className=3D&quot;button=
&quot;&gt;Submit&lt;/button&gt;
            &lt;/div&gt;
          &lt;/form&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    )
  }
}


ReactDOM.render(
  &lt;App /&gt;,
  document.getElementById('root')
