  baseQuery: fetchBaseQuery({ baseUrl: '/' }),
  tagTypes: ['Post'],
  endpoints: (build) =3D&gt; ({
    getPosts: build.query({
      query: () =3D&gt; 'posts',
      providesTags: ['Post'],
