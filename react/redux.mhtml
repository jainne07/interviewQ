n=3D"w" value=3D"const blogSlice =3D createSlice({
  name: 'blog',
  initialState: {
    posts: {
      byId: {},
      allIds: []
    },
    comments: {
      byPostId: {}
    }
  },
  reducers: {
    // Without Immer - very verbose
    addCommentWithoutImmer: (state, action) =3D&gt; {
      const { postId, comment } =3D action.payload;
      return {
        ...state,
        comments: {
          ...state.comments,
          byPostId: {
            ...state.comments.byPostId,
            [postId]: [
              ...(state.comments.byPostId[postId] || []),
              comment
            ]
          }
        }
      };
    },
   =20
    // With Immer - clean and simple
    addComment: (state, action) =3D&gt; {
      const { postId, comment } =3D action.payload;
      if (!state.comments.byPostId[postId]) {
        state.comments.byPostId[postId] =3D [];
      }
      state.comments.byPostId[postId].push(comment);
    },
   =20
    updateNestedPost: (state, action) =3D&gt; {
      const { postId, userId, updates } =3D action.payload;
      const post =3D state.posts.byId[postId];
      if (post &amp;&amp; post.author.id =3D=3D=3D userId) {
        // Deep mutations work fine
        post.author.name =3D updates.authorName;
        post.title =3D updates.title;
        post.metadata.lastEdited =3D Date.now();
      }
    }
  }
});" tabindex=3D"0" role=3D"button">
