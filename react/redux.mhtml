  <span class=3D"pl-k">return</span> <span class=3D"pl-s1">state</span><spa=
n class=3D"pl-kos">.</span><span class=3D"pl-c1">items</span><span class=3D=
"pl-kos">.</span><span class=3D"pl-en">map</span><span class=3D"pl-kos">(</=
