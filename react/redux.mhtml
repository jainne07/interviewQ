an><span class=3D"pl-kos">,</span>
  <span class=3D"pl-c1">name</span>: <span class=3D"pl-s">'Alex K'</span><s=
pan class=3D"pl-kos">,</span>
  <span class=3D"pl-c1">location</span>: <span class=3D"pl-s">'Lagos Nigeri=
a'</span><span class=3D"pl-kos">,</span>
  <span class=3D"pl-c1">email</span>: <span class=3D"pl-s">'alex@example.co=
m'</span>
<span class=3D"pl-kos">}</span></pre><div class=3D"zeroclipboard-container"=
