n=3D"w" value=3D"import { applyMiddleware, combineReducers, createStore } f=
rom 'redux' // =E2=9A=A0=EF=B8=8F createStore deprecated

import { thunk } from 'redux-thunk' // Named import required since redux-th=
unk v3

// actions.js
export const addRepos =3D repos =3D&gt; ({
  type: 'ADD_REPOS',
  repos,
})

export const clearRepos =3D () =3D&gt; ({ type: 'CLEAR_REPOS' })

export const getRepos =3D username =3D&gt; async dispatch =3D&gt; {
  try {
    const url =3D `https://api.github.com/users/${username}/repos?sort=3Dup=
dated`
    const response =3D await fetch(url)
    const responseBody =3D await response.json()
    dispatch(addRepos(responseBody))
  } catch (error) {
    console.error(error)
    dispatch(clearRepos())
  }
}

// reducers.js
export const repos =3D (state =3D [], action) =3D&gt; {
  switch (action.type) {
    case 'ADD_REPOS':
      return action.repos
    case 'CLEAR_REPOS':
      return []
    default:
      return state
  }
}

export const reducers =3D combineReducers({ repos })

// store.js
export function configureStore(initialState =3D {}) {
  const store =3D createStore(reducers, initialState, applyMiddleware(thunk=
))
  return store
}

