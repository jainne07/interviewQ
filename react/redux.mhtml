import { connect } from &quot;react-redux&quot;;

class LoginPage extends React.Component {
  constructor(props) {
    super(props);

    this.handleFormSubmit =3D this.handleFormSubmit.bind(this);
  }

  handleFormSubmit(values) {
    if (!this.props.isAuthenticating)
      this.props.dispatch({
        type: AUTHENTICATE,
        payload: values,
      });
  }

  render() {
    return (
      &lt;div&gt;
        &lt;LoginForm onSubmit=3D{this.handleFormSubmit} /&gt;
      &lt;/div&gt;
    );
  }
}

const mapStateToProps =3D (globalState) =3D&gt; {
  const { isAuthenticating } =3D globalState;
  return { isAuthenticating };
};

export default connect(mapStateToProps)(LoginPage);" tabindex=3D"0" role=3D=
