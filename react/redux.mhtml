n=3D"w" value=3D"import React, { useEffect } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { fetchUserById } from './usersSlice';

function UserProfile({ userId }) {
  const dispatch =3D useDispatch();
  const user =3D useSelector((state) =3D&gt; state.users.entities[userId]);
  const loading =3D useSelector((state) =3D&gt; state.users.loading);
  const error =3D useSelector((state) =3D&gt; state.users.error);

  useEffect(() =3D&gt; {
    dispatch(fetchUserById(userId));
  }, [dispatch, userId]);

  if (loading =3D=3D=3D 'pending') return &lt;div&gt;Loading...&lt;/div&gt;=
;
  if (error) return &lt;div&gt;Error: {error}&lt;/div&gt;;
  if (!user) return null;

  return (
    &lt;div&gt;
      &lt;h1&gt;{user.name}&lt;/h1&gt;
      &lt;p&gt;{user.email}&lt;/p&gt;
    &lt;/div&gt;
  );
}" tabindex=3D"0" role=3D"button">
