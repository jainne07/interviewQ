import { bindActionCreators } from 'redux';
import { connect } from 'react-redux';
import * as actions from './actions';

class MsgSenderPage extends React.Component {
 constructor(props) {
 super(props);
 const { dispatch } =3D props;
 this.boundedActions =3D bindActionCreators(actions, dispatch);
 }

 render() {
 return &lt;MsgSending {...this.boundedActions} /&gt;;
 }
}

export default connect()(MsgSenderPage);" tabindex=3D"0" role=3D"button">
