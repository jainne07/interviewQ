import { tokenRefreshed, loggedOut } from '../features/auth/authSlice'

const baseQuery =3D fetchBaseQuery({
  baseUrl: '/api',
  prepareHeaders: (headers, { getState }) =3D&gt; {
    const token =3D getState().auth.token
    if (token) headers.set('Authorization', `Bearer ${token}`)
    return headers
  },
})

// Wrap to handle token refresh on 401
const baseQueryWithReauth =3D async (args, api, extraOptions) =3D&gt; {
  let result =3D await baseQuery(args, api, extraOptions)

  if (result.error?.status =3D=3D=3D 401) {
    // Try to refresh the token
    const refreshResult =3D await baseQuery('/auth/refresh', api, extraOpti=
ons)
    if (refreshResult.data) {
      api.dispatch(tokenRefreshed(refreshResult.data))
      result =3D await baseQuery(args, api, extraOptions)
    } else {
      api.dispatch(loggedOut())
    }
  }
  return result
}

export const api =3D createApi({
  baseQuery: baseQueryWithReauth,
  endpoints: () =3D&gt; ({}),
})" tabindex=3D"0" role=3D"button">
