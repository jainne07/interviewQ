n=3D"w" value=3D"// Traditional Redux - manual immutable updates
function todosReducer(state =3D [], action) {
  switch (action.type) {
    case 'ADD_TODO':
      return [...state, action.payload];
   =20
    case 'TOGGLE_TODO':
      return state.map((todo, index) =3D&gt;
        index =3D=3D=3D action.payload
          ? { ...todo, completed: !todo.completed }
          : todo
      );
   =20
    case 'UPDATE_TODO':
      return state.map(todo =3D&gt;
        todo.id =3D=3D=3D action.payload.id
          ? { ...todo, ...action.payload.updates }
          : todo
      );
   =20
    case 'REMOVE_TODO':
      return state.filter(todo =3D&gt; todo.id !=3D=3D action.payload);
   =20
    default:
      return state;
  }
}" tabindex=3D"0" role=3D"button">
