n=3D"w" value=3D"/* Add decorative quotes around a blockquote */
blockquote::before {
  content: &quot;\201C&quot;; /* left double quotation mark */
  font-size: 2em;
  color: #aaa;
}

blockquote::after {
  content: &quot;\201D&quot;; /* right double quotation mark */
  font-size: 2em;
  color: #aaa;
}

/* Clearfix using ::after */
.clearfix::after {
  content: &quot;&quot;;
  display: block;
  clear: both;
}

/* Decorative underline effect */
.link-effect {
  position: relative;
  display: inline-block;
}

.link-effect::after {
  content: &quot;&quot;;
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 0;
  height: 2px;
  background: #3498db;
  transition: width 0.3s ease;
}

