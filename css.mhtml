<th>Value</th>
</tr>
</thead>
<tbody>
<tr>
<td>Universal selector</td>
<td><code>*</code></td>
<td>0</td>
</tr>
<tr>
<td>Element / pseudo-element</td>
<td><code>h1</code>, <code>::before</code></td>
