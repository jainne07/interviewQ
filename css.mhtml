  <span class=3D"pl-c1">opacity</span><span class=3D"pl-kos">:</span> <span=
 class=3D"pl-c1">30<span class=3D"pl-smi">%</span></span>; <span class=3D"p=
l-c">/* Barely see the text over the background */</span>
}
.<span class=3D"pl-c1">medium</span> {
  <span class=3D"pl-c1">opacity</span><span class=3D"pl-kos">:</span> <span=
 class=3D"pl-c1">60<span class=3D"pl-smi">%</span></span>; <span class=3D"p=
l-c">/* See the text more clearly over the background */</span>
}
.<span class=3D"pl-c1">heavy</span> {
  <span class=3D"pl-c1">opacity</span><span class=3D"pl-kos">:</span> <span=
 class=3D"pl-c1">100<span class=3D"pl-smi">%</span></span>; <span class=3D"=
pl-c">/* See the text very clearly over the background */</span>
}</pre><div class=3D"zeroclipboard-container">
