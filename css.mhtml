<p dir=3D"auto"><code>:not()</code> is a negation pseudo-class that selects=
 every element that does <strong>not</strong> match the given selector. In =
CSS3 it accepted only a single simple selector; from CSS4 it accepts a full=
 selector list.</p>
<p dir=3D"auto"><strong>Example:</strong></p>
<div class=3D"highlight highlight-source-css notranslate position-relative =
overflow-auto" dir=3D"auto"><pre><span class=3D"pl-c">/* Select all &lt;p&g=
t; elements that do NOT have the class .special */</span>
<span class=3D"pl-ent">p</span><span class=3D"pl-kos">:</span><span class=
=3D"pl-c1">not</span>(.<span class=3D"pl-c1">special</span>) {
  <span class=3D"pl-c1">color</span><span class=3D"pl-kos">:</span> <span c=
lass=3D"pl-pds"><span class=3D"pl-kos">#</span>555</span>;
}

<span class=3D"pl-c">/* Select all input elements that are not of type subm=
it */</span>
<span class=3D"pl-ent">input</span><span class=3D"pl-kos">:</span><span cla=
ss=3D"pl-c1">not</span>([<span class=3D"pl-c1">type</span><span class=3D"pl=
-c1">=3D</span><span class=3D"pl-s">"submit"</span>]) {
  <span class=3D"pl-c1">border</span><span class=3D"pl-kos">:</span> <span =
class=3D"pl-c1">1<span class=3D"pl-smi">px</span></span> solid <span class=
=3D"pl-pds"><span class=3D"pl-kos">#</span>ccc</span>;
}

<span class=3D"pl-c">/* CSS4: multiple selectors in :not() */</span>
<span class=3D"pl-ent">li</span><span class=3D"pl-kos">:</span><span class=
=3D"pl-c1">not</span>(<span class=3D"pl-kos">:</span><span class=3D"pl-c1">=
first-child</span>)<span class=3D"pl-kos">:</span><span class=3D"pl-c1">not=
</span>(<span class=3D"pl-kos">:</span><span class=3D"pl-c1">last-child</sp=
an>) {
  <span class=3D"pl-c1">border-top</span><span class=3D"pl-kos">:</span> <s=
pan class=3D"pl-c1">1<span class=3D"pl-smi">px</span></span> solid <span cl=
ass=3D"pl-pds"><span class=3D"pl-kos">#</span>eee</span>;
}

<span class=3D"pl-c">/* Equivalent using selector list (CSS4) */</span>
<span class=3D"pl-ent">li</span><span class=3D"pl-kos">:</span><span class=
=3D"pl-c1">not</span>(<span class=3D"pl-kos">:</span><span class=3D"pl-c1">=
first-child</span><span class=3D"pl-kos">,</span> <span class=3D"pl-kos">:<=
/span><span class=3D"pl-c1">last-child</span>) {
  <span class=3D"pl-c1">border-top</span><span class=3D"pl-kos">:</span> <s=
pan class=3D"pl-c1">1<span class=3D"pl-smi">px</span></span> solid <span cl=
ass=3D"pl-pds"><span class=3D"pl-kos">#</span>eee</span>;
}</pre><div class=3D"zeroclipboard-container">
