<th align=3D"center">A (IDs)</th>
<th align=3D"center">B (Classes, attributes, pseudo-classes)</th>
<th align=3D"center">C (Elements, pseudo-elements)</th>
</tr>
</thead>
<tbody>
<tr>
<td>Inline <code>style=3D""</code></td>
<td align=3D"center">=E2=80=94</td>
<td align=3D"center">=E2=80=94</td>
<td align=3D"center">=E2=80=94</td>
</tr>
<tr>
<td><code>#id</code></td>
<td align=3D"center">+1</td>
<td align=3D"center"></td>
<td align=3D"center"></td>
</tr>
<tr>
<td><code>.class</code>, <code>[attr]</code>, <code>:hover</code></td>
<td align=3D"center"></td>
<td align=3D"center">+1</td>
<td align=3D"center"></td>
</tr>
<tr>
<td><code>div</code>, <code>p</code>, <code>::before</code></td>
<td align=3D"center"></td>
<td align=3D"center"></td>
<td align=3D"center">+1</td>
</tr>
<tr>
<td><code>*</code>, <code>:is()</code>, <code>:not()</code>, <code>:has()</=
code></td>
<td align=3D"center">0</td>
<td align=3D"center">0</td>
<td align=3D"center">0 <em>(but their arguments count)</em></td>
</tr>
<tr>
<td><code>!important</code></td>
<td align=3D"center">Overrides all</td>
<td align=3D"center"></td>
<td align=3D"center"></td>
</tr>
</tbody>
</table></markdown-accessiblity-table>
