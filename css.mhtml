>header</span> <span class=3D"pl-ent">h3</span><span class=3D"pl-kos">,</sp=
an>
<span class=3D"pl-ent">main</span> <span class=3D"pl-ent">h1</span><span cl=
ass=3D"pl-kos">,</span>   <span class=3D"pl-ent">main</span> <span class=3D=
"pl-ent">h2</span><span class=3D"pl-kos">,</span>   <span class=3D"pl-ent">=
main</span> <span class=3D"pl-ent">h3</span><span class=3D"pl-kos">,</span>
<span class=3D"pl-ent">footer</span> <span class=3D"pl-ent">h1</span><span =
class=3D"pl-kos">,</span> <span class=3D"pl-ent">footer</span> <span class=
=3D"pl-ent">h2</span><span class=3D"pl-kos">,</span> <span class=3D"pl-ent"=
>footer</span> <span class=3D"pl-ent">h3</span> {
  <span class=3D"pl-c1">color</span><span class=3D"pl-kos">:</span> <span c=
lass=3D"pl-pds"><span class=3D"pl-kos">#</span>333</span>;
}

<span class=3D"pl-c">/* With :is() =E2=80=94 concise */</span>
<span class=3D"pl-kos">:</span><span class=3D"pl-c1">is</span>(<span class=
=3D"pl-ent">header</span><span class=3D"pl-kos">,</span> <span class=3D"pl-=
ent">main</span><span class=3D"pl-kos">,</span> <span class=3D"pl-ent">foot=
er</span>) <span class=3D"pl-kos">:</span><span class=3D"pl-c1">is</span>(<=
span class=3D"pl-ent">h1</span><span class=3D"pl-kos">,</span> <span class=
