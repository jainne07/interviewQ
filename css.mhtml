an class=3D"pl-c1">16<span class=3D"pl-smi">px</span></span>;
  <span class=3D"pl-c1">line-height</span><span class=3D"pl-kos">:</span> <=
span class=3D"pl-c1">1.5</span>; <span class=3D"pl-c">/* 16px =C3=97 1.5 =
=3D 24px line height */</span>
}

<span class=3D"pl-c">/* Fixed length */</span>
<span class=3D"pl-ent">h1</span> {
  <span class=3D"pl-c1">line-height</span><span class=3D"pl-kos">:</span> <=
span class=3D"pl-c1">40<span class=3D"pl-smi">px</span></span>;
}

<span class=3D"pl-c">/* Percentage */</span>
<span class=3D"pl-ent">h2</span> {
  <span class=3D"pl-c1">line-height</span><span class=3D"pl-kos">:</span> <=
span class=3D"pl-c1">150<span class=3D"pl-smi">%</span></span>;
}</pre><div class=3D"zeroclipboard-container">
