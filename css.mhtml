class=3D"pl-c1">1.25<span class=3D"pl-smi">em</span></span>;
  <span class=3D"pl-c1">vertical-align</span><span class=3D"pl-kos">:</span=
> middle;
}</pre><div class=3D"zeroclipboard-container">
