i">%</span></span>); <span class=3D"pl-c1">opacity</span><span class=3D"pl-=
kos">:</span> <span class=3D"pl-c1">0</span>; }
  <span class=3D"pl-c1">60<span class=3D"pl-smi">%</span></span>  { <span c=
lass=3D"pl-c1">transform</span><span class=3D"pl-kos">:</span> <span class=
=3D"pl-en">translateX</span>(<span class=3D"pl-c1">10<span class=3D"pl-smi"=
>px</span></span>);  <span class=3D"pl-c1">opacity</span><span class=3D"pl-=
kos">:</span> <span class=3D"pl-c1">1</span>; }
  <span class=3D"pl-c1">100<span class=3D"pl-smi">%</span></span> { <span c=
lass=3D"pl-c1">transform</span><span class=3D"pl-kos">:</span> <span class=
