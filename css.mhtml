.<span class=3D"pl-c1">child</span>  { <span class=3D"pl-c1">position</span=
><span class=3D"pl-kos">:</span> sticky; <span class=3D"pl-c1">top</span><s=
pan class=3D"pl-kos">:</span> <span class=3D"pl-c1">0</span>; }

