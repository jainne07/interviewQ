pan class=3D"pl-en">linear-gradient</span>(blue<span class=3D"pl-kos">,</sp=
an> pink);
}

<span class=3D"pl-c">/* Example - 02: Changing the direction */</span>
.<span class=3D"pl-c1">horizontal-gradient</span> {
  <span class=3D"pl-c1">background</span><span class=3D"pl-kos">:</span> <s=
pan class=3D"pl-en">linear-gradient</span>(to right<span class=3D"pl-kos">,=
</span> blue<span class=3D"pl-kos">,</span> pink);
}

<span class=3D"pl-c">/* Example - 03: Diagonal gradients */</span>
.<span class=3D"pl-c1">diagonal-gradient</span> {
  <span class=3D"pl-c1">background</span><span class=3D"pl-kos">:</span> <s=
pan class=3D"pl-en">linear-gradient</span>(to bottom right<span class=3D"pl=
-kos">,</span> blue<span class=3D"pl-kos">,</span> pink);
