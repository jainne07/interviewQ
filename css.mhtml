dButton btn btn-invisible js-clipboard-copy m-2 p-0 d-flex flex-justify-cen=
ter flex-items-center" data-copy-feedback=3D"Copied!" data-tooltip-directio=
n=3D"w" value=3D"/* inherit: force a non-inherited property to use the pare=
nt\'s value */
.child {
  border-color: inherit;   /* border-color is NOT normally inherited */
}

/* initial: CSS spec default =E2=80=94 may differ from browser default */
h1 {
  font-weight: initial;   /* 'normal' per spec; browser default is 'bold' *=
/
  display: initial;       /* 'inline' per spec; browser default is 'block' =
*/
}

/* unset: smart inherit-or-reset */
.reset {
  color: unset;     /* inherits (color is an inherited property) */
  display: unset;   /* becomes 'initial' (display is NOT inherited) */
}

/* revert: restore browser default styling */
button {
  all: revert;  /* strips all author styles, restores native button appeara=
nce */
}" tabindex=3D"0" role=3D"button">
