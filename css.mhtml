n=3D"w" value=3D"/* Base (mobile): single-column layout */
.layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  padding: 1rem;
}

.sidebar {
  order: 2; /* Sidebar below content on mobile */
}

/* Tablet (=E2=89=A5 768px): two-column layout */
@media (min-width: 768px) {
  .layout {
    grid-template-columns: 1fr 2fr;
    padding: 2rem;
  }

  .sidebar {
    order: 0; /* Restore natural order */
  }
}

/* Desktop (=E2=89=A5 1200px): three-column layout */
@media (min-width: 1200px) {
  .layout {
    grid-template-columns: 250px 1fr 200px;
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }
