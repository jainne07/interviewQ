  <span class=3D"pl-c1">border</span><span class=3D"pl-kos">:</span> <span =
class=3D"pl-c1">5<span class=3D"pl-smi">px</span></span> solid <span class=
=3D"pl-pds"><span class=3D"pl-kos">#</span>333</span>;
}

<span class=3D"pl-c">/* border-box: total rendered width =3D 200px */</span=
