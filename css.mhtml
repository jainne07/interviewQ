.<span class=3D"pl-c1">box-border</span> {
  <span class=3D"pl-c1">box-sizing</span><span class=3D"pl-kos">:</span> bo=
rder-box;
  <span class=3D"pl-c1">width</span><span class=3D"pl-kos">:</span> <span c=
lass=3D"pl-c1">200<span class=3D"pl-smi">px</span></span>;
