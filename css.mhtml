dButton btn btn-invisible js-clipboard-copy m-2 p-0 d-flex flex-justify-cen=
ter flex-items-center" data-copy-feedback=3D"Copied!" data-tooltip-directio=
n=3D"w" value=3D"/* Style valid and invalid inputs */
input:valid {
  border-color: #2ecc71;
}

input:invalid {
  border-color: #e74c3c;
}

/* Show error message only when input is invalid and not empty */
input:not(:placeholder-shown):invalid + .error-msg {
  display: block;
}

/* Focus styling that doesn\'t show on mouse click */
button:focus-visible {
  outline: 3px solid #3498db;
  outline-offset: 2px;
}

/* Dim disabled inputs */
input:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}" tabindex=3D"0" role=3D"button">
