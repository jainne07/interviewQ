<span class=3D"pl-kos">:</span><span class=3D"pl-c1">root</span> {
  <span class=3D"pl-s1">--color-primary</span><span class=3D"pl-kos">:</spa=
n> <span class=3D"pl-pds"><span class=3D"pl-kos">#</span>3498db</span>;
  <span class=3D"pl-s1">--font-size</span><span class=3D"pl-kos">:</span> <=
span class=3D"pl-c1">16<span class=3D"pl-smi">px</span></span>;
}

<span class=3D"pl-c">/* Component scope =E2=80=94 only available inside .ca=
rd */</span>
.<span class=3D"pl-c1">card</span> {
  <span class=3D"pl-s1">--card-padding</span><span class=3D"pl-kos">:</span=
> <span class=3D"pl-c1">1.5<span class=3D"pl-smi">rem</span></span>;
  <span class=3D"pl-s1">--card-bg</span><span class=3D"pl-kos">:</span> <sp=
an class=3D"pl-pds"><span class=3D"pl-kos">#</span>f9f9f9</span>;
  <span class=3D"pl-c1">background-color</span><span class=3D"pl-kos">:</sp=
an> <span class=3D"pl-en">var</span>(<span class=3D"pl-s1">--card-bg</span>=
);
  <span class=3D"pl-c1">padding</span><span class=3D"pl-kos">:</span> <span=
 class=3D"pl-en">var</span>(<span class=3D"pl-s1">--card-padding</span>);
}

<span class=3D"pl-c">/* .card__title can access both :root vars and .card v=
ars */</span>
.<span class=3D"pl-c1">card__title</span> {
  <span class=3D"pl-c1">font-size</span><span class=3D"pl-kos">:</span> <sp=
an class=3D"pl-en">var</span>(<span class=3D"pl-s1">--font-size</span>);   =
