<td>100=E2=80=93900</td>
</tr>
<tr>
<td>Width</td>
<td><code>font-stretch</code></td>
<td>50%=E2=80=93200%</td>
</tr>
<tr>
<td>Italic/Slant</td>
<td><code>font-style</code></td>
<td><code>oblique 0=E2=80=9320deg</code></td>
</tr>
<tr>
<td>Optical Size</td>
