.<span class=3D"pl-c1">always-scroll</span> {
  <span class=3D"pl-c1">width</span><span class=3D"pl-kos">:</span> <span c=
lass=3D"pl-c1">200<span class=3D"pl-smi">px</span></span>;
  <span class=3D"pl-c1">height</span><span class=3D"pl-kos">:</span> <span =
class=3D"pl-c1">100<span class=3D"pl-smi">px</span></span>;
  <span class=3D"pl-c1">overflow</span><span class=3D"pl-kos">:</span> scro=
ll;
}

<span class=3D"pl-c">/* Scrollbars appear only when content overflows */</s=
pan>
.<span class=3D"pl-c1">smart-scroll</span> {
  <span class=3D"pl-c1">width</span><span class=3D"pl-kos">:</span> <span c=
lass=3D"pl-c1">200<span class=3D"pl-smi">px</span></span>;
  <span class=3D"pl-c1">height</span><span class=3D"pl-kos">:</span> <span =
class=3D"pl-c1">100<span class=3D"pl-smi">px</span></span>;
