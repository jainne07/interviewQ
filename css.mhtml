lass=3D"pl-pds"><span class=3D"pl-kos">#</span>333</span>;
}

<span class=3D"pl-c">/* Combining with other selectors */</span>
<span class=3D"pl-kos">:</span><span class=3D"pl-c1">is</span>(<span class=
=3D"pl-ent">ul</span><span class=3D"pl-kos">,</span> <span class=3D"pl-ent"=
>ol</span>) <span class=3D"pl-c1">&gt;</span> <span class=3D"pl-ent">li</sp=
an> {
  <span class=3D"pl-c1">margin-bottom</span><span class=3D"pl-kos">:</span>=
 <span class=3D"pl-c1">0.5<span class=3D"pl-smi">em</span></span>;
