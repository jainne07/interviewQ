ass=3D"pl-c1">has</span>(<span class=3D"pl-ent">img</span>) {
  <span class=3D"pl-c1">border</span><span class=3D"pl-kos">:</span> <span =
class=3D"pl-c1">2<span class=3D"pl-smi">px</span></span> solid <span class=
=3D"pl-pds"><span class=3D"pl-kos">#</span>ccc</span>;
  <span class=3D"pl-c1">padding</span><span class=3D"pl-kos">:</span> <span=
 class=3D"pl-c1">1<span class=3D"pl-smi">rem</span></span>;
}

<span class=3D"pl-c">/* Select a &lt;label&gt; that is immediately followed=
 by an invalid input */</span>
<span class=3D"pl-ent">label</span><span class=3D"pl-kos">:</span><span cla=
ss=3D"pl-c1">has</span>(<span class=3D"pl-ent"></span><span class=3D"pl-c1"=
></span><span class=3D"pl-c1">+</span> <span class=3D"pl-ent">input</span><=
span class=3D"pl-kos">:</span><span class=3D"pl-c1">invalid</span>) {
  <span class=3D"pl-c1">color</span><span class=3D"pl-kos">:</span> red;
}

<span class=3D"pl-c">/* Select a &lt;div&gt; that contains a &lt;p&gt; */</=
span>
<span class=3D"pl-ent">div</span><span class=3D"pl-kos">:</span><span class=
=3D"pl-c1">has</span>(<span class=3D"pl-ent"></span><span class=3D"pl-c1"><=
/span><span class=3D"pl-c1">&gt;</span> <span class=3D"pl-ent">p</span>) {
